<div class="sc-body sc-session-body">
  <div class="sc-title-row"><h2>{{localize "DOWNTIME_MANAGER.Session.Title"}}</h2>{{#if isPrimaryWorld}}<div class="sc-section-actions"><button type="button" data-action="configureRewards"><i class="fa-solid fa-gift"></i> {{localize "DOWNTIME_MANAGER.Session.ConfigureRewards"}}</button><button type="button" data-action="history"><i class="fa-solid fa-book"></i> {{localize "DOWNTIME_MANAGER.Session.History"}}</button></div>{{/if}}</div>
  <section class="sc-session-workflow {{#if isSessionWorld}}session-world{{/if}}">
    <header><strong>{{localize "DOWNTIME_MANAGER.Session.Workflow.Title"}}</strong><span>{{localize "DOWNTIME_MANAGER.Session.Workflow.Status"}}: {{workflowStatus}}</span></header>
    {{#if isPrimaryWorld}}
      {{#if workflowCanImportResult}}<div class="sc-session-result-row"><label><span>{{localize "DOWNTIME_MANAGER.Session.Workflow.ResultFile"}}</span><input type="file" name="workflowResultFile" accept="application/json,.json"></label><button type="button" data-action="workflowImportResult"><i class="fa-solid fa-file-import"></i> {{localize "DOWNTIME_MANAGER.Session.Workflow.Complete"}}</button></div>{{/if}}
      {{#if workflowReturned}}<p class="notification info">{{localize "DOWNTIME_MANAGER.Session.Workflow.ReturnedHint"}}</p>{{/if}}
    {{/if}}
    {{#if isSessionWorld}}
      <div class="sc-session-import-row">
        <label><input type="file" name="workflowSessionFile" accept="application/json,.json" aria-label="{{localize 'DOWNTIME_MANAGER.Session.Workflow.SessionFile'}}"></label>
        <button type="button" data-action="workflowImportSession"><i class="fa-solid fa-file-import"></i> {{localize "DOWNTIME_MANAGER.Session.Workflow.Begin"}}</button>
      </div>
      {{#if workflowCanCleanup}}<div class="sc-session-operation-row">
        <button type="button" data-action="workflowExportResult"><i class="fa-solid fa-file-export"></i> {{localize "DOWNTIME_MANAGER.Session.Workflow.End"}}</button>
        <button type="button" class="danger" data-action="workflowCleanup"><i class="fa-solid fa-trash"></i> {{localize "DOWNTIME_MANAGER.Session.Workflow.Cleanup"}}</button>
        <button type="button" data-action="workflowReset"><i class="fa-solid fa-rotate"></i> {{localize "DOWNTIME_MANAGER.Session.Workflow.NewSession"}}</button>
      </div>{{/if}}
    {{/if}}
  </section>
  {{#if isSessionWorld}}
    {{#if workflowHasSession}}<section class="sc-session-current"><h3>{{active.title}}</h3>{{#if active.summary}}<p>{{active.summary}}</p>{{/if}}</section>{{/if}}
  {{/if}}
  {{#if isPrimaryWorld}}
  {{#if awarded}}<p class="notification info">{{localize "DOWNTIME_MANAGER.Session.AlreadyAwarded"}}</p>{{/if}}
  <div class="sc-session-fields"><label><span>{{localize "DOWNTIME_MANAGER.Session.Name"}}</span><input type="text" name="title" value="{{active.title}}" {{#if awarded}}disabled{{/if}}></label><div class="sc-session-package-action">{{#if workflowCanExportSession}}<button type="button" data-action="workflowExportSession"><i class="fa-solid fa-file-export"></i> {{localize "DOWNTIME_MANAGER.Session.Workflow.Prepare"}}</button>{{/if}}</div><label class="wide"><span>{{localize "DOWNTIME_MANAGER.Session.Summary"}}</span><textarea name="summary" {{#if awarded}}disabled{{/if}}>{{active.summary}}</textarea></label></div>
  <details class="sc-session-players" {{#unless awarded}}open{{/unless}}>
    <summary>{{localize "DOWNTIME_MANAGER.Session.PlayerSelection"}}</summary>
    <div class="sc-session-actions">
      <label><span>{{localize "TOVF.Session.SelectionMode.Label"}}</span><select name="selectionMode"><option value="character">{{localize "TOVF.Session.SelectionMode.Character"}}</option><option value="player">{{localize "TOVF.Session.SelectionMode.Player"}}</option></select></label>
      <button type="button" data-action="selectAll" {{#if awarded}}disabled{{/if}}>{{localize "TOVF.Session.Primary.SelectAll"}}</button><button type="button" data-action="selectNone" {{#if awarded}}disabled{{/if}}>{{localize "TOVF.Session.Primary.SelectNone"}}</button><button type="button" data-action="selectConnected" {{#if awarded}}disabled{{/if}}>{{localize "DOWNTIME_MANAGER.Session.SelectConnected"}}</button><button type="button" data-action="selectTokens" {{#if awarded}}disabled{{/if}}>{{localize "DOWNTIME_MANAGER.Session.SelectTokens"}}</button>
      <label class="sc-session-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-actor-search placeholder="{{localize 'TOVF.Session.Search'}}" autocomplete="off"></label>
    </div>
    <div class="sc-session-actors" data-character-selection>{{#each actors}}<label class="sc-session-actor" data-actor-search-text="{{name}} {{folder}}"><input type="checkbox" name="actors" value="{{uuid}}" {{checked selected}} {{#if ../awarded}}disabled{{/if}}><img class="sc-session-actor-img" src="{{img}}" alt=""><span class="sc-session-actor-name"><strong>{{name}}</strong><small>{{folder}}</small><small>{{localize "DOWNTIME_MANAGER.Session.Level"}} {{level}} · {{localize "DOWNTIME_MANAGER.Session.Available"}}: {{downtime}}</small></span><span class="sc-session-reward"><span class="sc-session-reward-items">{{#each rewardItems}}<span class="sc-session-reward-chip {{#unless selected}}disabled{{/unless}}"><img src="{{img}}" alt=""><span>{{name}}</span><strong>×{{quantity}}</strong></span>{{else}}<span class="notes">{{localize "DOWNTIME_MANAGER.Common.None"}}</span>{{/each}}</span><small>{{localize "DOWNTIME_MANAGER.Session.Milestones"}}: {{milestones}} · {{localize "DOWNTIME_MANAGER.Session.Passive"}}: {{passive}}</small></span></label>{{else}}<p class="notes">{{localize "DOWNTIME_MANAGER.Session.NoActors"}}</p>{{/each}}</div>
    <div class="sc-session-actors sc-session-player-list" data-player-selection hidden>
      {{#each connectedPlayers}}<label class="sc-session-player" data-actor-search-text="{{searchText}}"><input type="checkbox" name="players" data-actor-uuids="{{actorUuids}}" {{checked selected}} {{#if ../awarded}}disabled{{/if}}><i class="fa-solid fa-circle sc-session-online"></i><span><strong>{{name}}</strong><small>{{characters}}</small></span></label>{{/each}}
      {{#each otherPlayers}}<label class="sc-session-player" data-actor-search-text="{{searchText}}"><input type="checkbox" name="players" data-actor-uuids="{{actorUuids}}" {{checked selected}} {{#if ../awarded}}disabled{{/if}}><i class="fa-regular fa-circle"></i><span><strong>{{name}}</strong><small>{{characters}}</small></span></label>{{/each}}
    </div>
  </details>
  <fieldset class="sc-session-distribution"><legend class="sc-session-distribution-legend"><span>{{localize "DOWNTIME_MANAGER.Session.Distribute"}}</span><label><span>{{localize "DOWNTIME_MANAGER.Session.Multiplier"}}</span><select name="multiplier" {{#if awarded}}disabled{{/if}}>{{#each multipliers}}<option value="{{value}}" {{#if selected}}selected{{/if}}>×{{value}}</option>{{/each}}</select></label></legend><div class="sc-session-column-toggles">{{#each rewardColumns}}<label class="checkbox"><input type="checkbox" name="rewardColumns" value="{{index}}" {{checked selected}} {{#if ../awarded}}disabled{{/if}}><img src="{{img}}" alt=""><span>{{name}}</span></label>{{/each}}<label class="checkbox sc-session-milestone-toggle"><input type="checkbox" name="awardMilestones" {{checked awardMilestones}} {{#if awarded}}disabled{{/if}}> <i class="fa-solid fa-flag"></i><span>{{localize "DOWNTIME_MANAGER.Session.DistributeMilestones"}}</span></label></div></fieldset>
  <div class="sc-session-footer">{{#if awarded}}<button type="button" data-action="newSession"><i class="fa-solid fa-plus"></i> {{localize "DOWNTIME_MANAGER.Session.New"}}</button>{{else}}{{#if canStartConcurrentSession}}<button type="button" data-action="newSession"><i class="fa-solid fa-plus"></i> {{localize "DOWNTIME_MANAGER.Session.New"}}</button>{{/if}}{{#if canSaveSession}}<button type="button" data-action="save"><i class="fa-solid fa-floppy-disk"></i> {{localize "DOWNTIME_MANAGER.Session.Save"}}</button>{{/if}}{{#if canAwardSession}}<button type="button" data-action="award"><i class="fa-solid fa-gift"></i> {{localize "DOWNTIME_MANAGER.Session.Award"}}</button>{{/if}}{{/if}}{{#if isPrimaryWorld}}<label><span>{{localize "DOWNTIME_MANAGER.Session.Settlement"}}</span>{{#if passiveWeekly}}<input type="week" name="period" value="{{periodKey}}">{{else}}<input type="month" name="period" value="{{periodKey}}">{{/if}}</label><button type="button" data-action="settle">{{localize "DOWNTIME_MANAGER.Session.Settle"}}</button>{{/if}}</div>
  {{/if}}
</div>
