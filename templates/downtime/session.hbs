<div class="sc-body sc-session-body">
  <div class="sc-title-row"><h2>{{localize "DOWNTIME_MANAGER.Session.Title"}}</h2>{{#if isPrimaryWorld}}<div class="sc-section-actions"><button type="button" data-action="configureRewards"><i class="fa-solid fa-gift"></i> {{localize "DOWNTIME_MANAGER.Session.ConfigureRewards"}}</button><button type="button" data-action="correctSession"><i class="fa-solid fa-pen-to-square"></i> {{localize "DOWNTIME_MANAGER.Session.Correction.Action"}}</button><button type="button" data-action="history"><i class="fa-solid fa-book"></i> {{localize "DOWNTIME_MANAGER.Session.History"}}</button></div>{{/if}}</div>
  <section class="sc-session-workflow {{#if isSessionWorld}}session-world{{/if}}">
    <header><strong>{{localize "DOWNTIME_MANAGER.Session.Workflow.Title"}}</strong><span>{{localize "DOWNTIME_MANAGER.Session.Workflow.Status"}}: {{workflowStatus}}</span></header>
    {{#if isPrimaryWorld}}
      {{#if workflowCanImportResult}}<div class="sc-session-result-row"><label><span>{{localize "DOWNTIME_MANAGER.Session.Workflow.ResultFile"}}</span><input type="file" name="workflowResultFile" accept="application/json,.json"></label><button type="button" data-action="workflowImportResult"><i class="fa-solid fa-file-import"></i> {{localize "DOWNTIME_MANAGER.Session.Workflow.Complete"}}</button></div>{{/if}}
      {{#if workflowReturned}}<p class="notification info">{{localize "DOWNTIME_MANAGER.Session.Workflow.ReturnedHint"}}</p>{{/if}}
    {{/if}}
    {{#if isSessionWorld}}
      <div class="sc-session-import-row">
        <label><input type="file" name="workflowSessionFile" accept="application/json,.json" aria-label="{{localize 'DOWNTIME_MANAGER.Session.Workflow.SessionFile'}}"></label>
        <button type="button" data-action="workflowImportSession"><i class="fa-solid fa-file-import"></i> {{localize "DOWNTIME_MANAGER.Session.Workflow.Begin"}}</button>
      </div>
      {{#if workflowCanCleanup}}<div class="sc-session-operation-row">
        <button type="button" data-action="workflowExportResult"><i class="fa-solid fa-file-export"></i> {{localize "DOWNTIME_MANAGER.Session.Workflow.End"}}</button>
        <button type="button" class="danger" data-action="workflowCleanup"><i class="fa-solid fa-trash"></i> {{localize "DOWNTIME_MANAGER.Session.Workflow.Cleanup"}}</button>
        <button type="button" data-action="workflowReset"><i class="fa-solid fa-rotate"></i> {{localize "DOWNTIME_MANAGER.Session.Workflow.NewSession"}}</button>
      </div>{{/if}}
    {{/if}}
  </section>
  {{#if isSessionWorld}}
    {{#if workflowHasSession}}<section class="sc-session-current">
      <header><div><small>Aktuelle Session</small><h3>{{active.title}}</h3></div><span class="status">{{workflowStatus}}</span></header>
      <div class="sc-session-current-description"><strong>{{localize "DOWNTIME_MANAGER.Session.Summary"}}</strong>{{#if sessionOverview.description}}<p>{{sessionOverview.description}}</p>{{else}}<p class="notes">Keine Beschreibung hinterlegt.</p>{{/if}}</div>
      <div class="sc-session-current-participants"><strong>Spieler und Charaktere</strong><div class="sc-session-current-grid">{{#each sessionOverview.participants}}<article><img src="{{img}}" alt=""><span><b>{{name}}</b><small><i class="fa-solid fa-user{{#if online}}-check{{/if}}"></i> {{players}}</small></span></article>{{else}}<p class="notes">Keine Teilnehmer hinterlegt.</p>{{/each}}</div></div>
    </section>{{/if}}
    <section class="sc-session-import-history">
      <header><div><small>Sessioninhalte</small><h3>Aktive Importe</h3></div><span>{{activeImports.length}}</span></header>
      <div class="sc-session-import-cards">{{#each activeImports}}<article><div><strong>{{title}}</strong><small><i class="fa-solid fa-clock"></i> {{date}}{{#if sourceWorld}} &middot; {{sourceWorld}}{{/if}}</small><span><b>{{actorCount}}</b> Actors <b>{{userCount}}</b> Spieler</span></div><button type="button" class="danger" data-action="workflowCleanupHistory" data-import-id="{{importId}}" data-tooltip="Entfernt nur die Inhalte dieses Imports"><i class="fa-solid fa-trash"></i> {{localize "TOVF.Session.ImportHistory.Cleanup"}}</button></article>{{else}}<p class="notes">Keine aktiven Sessionimporte vorhanden.</p>{{/each}}</div>
    </section>
    {{#if cleanedImportCount}}<details class="sc-session-cleaned-history"><summary>Bereinigte Importe <span>{{cleanedImportCount}}</span></summary><div class="sc-session-cleaned-list">{{#each cleanedImports}}<article><span><strong>{{title}}</strong><small>Importiert {{date}}{{#if cleanedDate}} &middot; bereinigt {{cleanedDate}}{{/if}}</small></span><i class="fa-solid fa-circle-check" data-tooltip="Inhalte gelöscht"></i></article>{{/each}}</div><footer><small>Es werden höchstens die letzten 10 Einträge angezeigt.</small><button type="button" data-action="clearCleanedImportHistory"><i class="fa-solid fa-broom"></i> Bereinigungsverlauf leeren</button></footer></details>{{/if}}
  {{/if}}
  {{#if isPrimaryWorld}}
  {{#if awarded}}<p class="notification info">{{localize "DOWNTIME_MANAGER.Session.AlreadyAwarded"}}</p>{{/if}}
  <div class="sc-session-fields">
    <label class="sc-session-name"><span>{{localize "DOWNTIME_MANAGER.Session.Name"}}</span><input type="text" name="title" value="{{active.title}}" {{#if awarded}}disabled{{/if}}></label>
    <label class="sc-session-gm"><span>{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Types.gm"}}</span><select name="sessionGm" {{#if awarded}}disabled{{/if}}><option value="">{{localize 'TOVF.Interface.PleaseSelect_a9b8bd'}}</option>{{#each gmUsers}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label class="sc-session-transfer-scenes-toggle" data-tooltip="{{localize 'TOVF.Session.IncludeTransferScenes'}}"><input type="checkbox" name="includeTransferScenes" {{checked includeTransferScenes}} {{#if awarded}}disabled{{/if}}><span><i class="fa-solid fa-map" inert></i> {{localize "TOVF.Session.IncludeTransferScenesShort"}}</span></label>
    {{#if workflowCanExportSession}}<div class="sc-session-package-action"><button type="button" data-action="workflowExportSession"><i class="fa-solid fa-file-export"></i> {{localize "DOWNTIME_MANAGER.Session.Workflow.Prepare"}}</button></div>{{/if}}
    <label class="wide"><span>{{localize "DOWNTIME_MANAGER.Session.Summary"}}</span><textarea name="summary" {{#if awarded}}disabled{{/if}}>{{active.summary}}</textarea></label>
  </div>
  <details class="sc-session-players" {{#unless awarded}}open{{/unless}}>
    <summary>{{localize "DOWNTIME_MANAGER.Session.PlayerSelection"}}</summary>
    <div class="sc-session-actions">
      <label class="sc-session-selection-mode"><span>{{localize "TOVF.Session.SelectionMode.Label"}}</span><select name="selectionMode"><option value="character">{{localize "TOVF.Session.SelectionMode.Character"}}</option><option value="player">{{localize "TOVF.Session.SelectionMode.Player"}}</option></select></label>
      <div class="sc-session-selection-quick-actions"><button type="button" data-action="selectAll" {{#if awarded}}disabled{{/if}}>{{localize "TOVF.Session.Primary.SelectAllShort"}}</button><button type="button" data-action="selectNone" {{#if awarded}}disabled{{/if}}>{{localize "TOVF.Session.Primary.SelectNoneShort"}}</button><button type="button" data-action="selectConnected" {{#if awarded}}disabled{{/if}}>{{localize "TOVF.Session.Primary.SelectConnectedShort"}}</button><button type="button" data-action="selectTokens" {{#if awarded}}disabled{{/if}}>{{localize "TOVF.Session.Primary.SelectTokensShort"}}</button></div>
      <div class="sc-session-selection-filters">{{#if hasInactive}}<button type="button" data-action="toggleInactive" data-tooltip="{{#if showInactive}}{{localize 'DOWNTIME_MANAGER.GMTools.Activity.HideInactive'}}{{else}}{{localize 'DOWNTIME_MANAGER.GMTools.Activity.ShowInactive'}}{{/if}}"><i class="fa-solid fa-user-slash" inert></i></button>{{/if}}<label class="sc-session-search"><i class="fa-solid fa-magnifying-glass" inert></i><input type="search" data-actor-search placeholder="{{localize 'TOVF.Session.Search'}}" autocomplete="off"></label></div>
    </div>
    <div class="sc-session-actors" data-character-selection>{{#each actors}}<label class="sc-session-actor" data-actor-search-text="{{name}} {{folder}}"><input type="checkbox" name="actors" value="{{uuid}}" {{checked selected}} {{#if ../awarded}}disabled{{/if}}><img class="sc-session-actor-img" src="{{img}}" alt=""><span class="sc-session-actor-name"><strong>{{name}}</strong>{{#unless characterActive}}<small><i class="fa-solid fa-user-slash"></i> {{localize "DOWNTIME_MANAGER.GMTools.Inactive"}}</small>{{/unless}}<small>{{folder}}</small><small>{{localize "DOWNTIME_MANAGER.Session.Level"}} {{level}} · {{localize "DOWNTIME_MANAGER.Session.Available"}}: {{downtime}}</small></span><span class="sc-session-reward"><span class="sc-session-reward-items">{{#each rewardItems}}<span class="sc-session-reward-chip {{#unless selected}}disabled{{/unless}}"><img src="{{img}}" alt=""><span>{{name}}</span><strong>×{{quantity}}</strong></span>{{else}}<span class="notes">{{localize "DOWNTIME_MANAGER.Common.None"}}</span>{{/each}}</span><small>{{localize "DOWNTIME_MANAGER.Session.Milestones"}}: {{milestones}} · {{localize "DOWNTIME_MANAGER.Session.Passive"}}: {{passive}}</small></span></label>{{else}}<p class="notes">{{localize "DOWNTIME_MANAGER.Session.NoActors"}}</p>{{/each}}</div>
    <div class="sc-session-actors sc-session-player-list" data-player-selection hidden>
      {{#each connectedPlayers}}<label class="sc-session-player" data-actor-search-text="{{searchText}}"><input type="checkbox" name="players" data-actor-uuids="{{actorUuids}}" {{checked selected}} {{#if ../awarded}}disabled{{/if}}><i class="fa-solid fa-circle sc-session-online"></i><span><strong>{{name}}</strong><small>{{characters}}</small></span></label>{{/each}}
      {{#each otherPlayers}}<label class="sc-session-player" data-actor-search-text="{{searchText}}"><input type="checkbox" name="players" data-actor-uuids="{{actorUuids}}" {{checked selected}} {{#if ../awarded}}disabled{{/if}}><i class="fa-regular fa-circle"></i><span><strong>{{name}}</strong><small>{{characters}}</small></span></label>{{/each}}
    </div>
  </details>
  <fieldset class="sc-session-distribution"><legend class="sc-session-distribution-legend"><span>{{localize "DOWNTIME_MANAGER.Session.Distribute"}}</span><label><span>{{localize "DOWNTIME_MANAGER.Session.Multiplier"}}</span><select name="multiplier" {{#if awarded}}disabled{{/if}}>{{#each multipliers}}<option value="{{value}}" {{#if selected}}selected{{/if}}>×{{value}}</option>{{/each}}</select></label></legend><div class="sc-session-column-toggles">{{#each rewardColumns}}<label class="checkbox"><input type="checkbox" name="rewardColumns" value="{{index}}" {{checked selected}} {{#if ../awarded}}disabled{{/if}}><img src="{{img}}" alt=""><span>{{name}}</span></label>{{/each}}<label class="checkbox sc-session-milestone-toggle"><input type="checkbox" name="awardMilestones" {{checked awardMilestones}} {{#if awarded}}disabled{{/if}}> <i class="fa-solid fa-flag"></i><span>{{localize "DOWNTIME_MANAGER.Session.DistributeMilestones"}}</span></label></div></fieldset>
  <div class="sc-session-footer"><button type="button" data-action="newSession"><i class="fa-solid fa-plus"></i> {{localize "DOWNTIME_MANAGER.Session.New"}}</button>{{#unless awarded}}{{#if canSaveSession}}<button type="button" data-action="save"><i class="fa-solid fa-floppy-disk"></i> {{localize "DOWNTIME_MANAGER.Session.Save"}}</button>{{/if}}{{#if canAwardSession}}<button type="button" data-action="award"><i class="fa-solid fa-gift"></i> {{localize "DOWNTIME_MANAGER.Session.Award"}}</button>{{/if}}{{/unless}}</div>
  {{/if}}
</div>
