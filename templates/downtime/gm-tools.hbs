<div class="tovf-gm-tools-root">
  <header class="tovf-gm-tools-header">
    <nav class="tovf-gm-tabs">
      {{#each tabs}}
      <button type="button" data-action="selectTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>
      {{/each}}
    </nav>
    <div class="tovf-gm-tools-global">
      <button type="button" data-action="refresh" title="{{localize 'DOWNTIME_MANAGER.GMTools.Refresh'}}"><i class="fa-solid fa-rotate"></i></button>
    </div>
  </header>
  {{#if undo.available}}<div class="tovf-gm-undo-row"><span>{{undo.subject}} &middot; {{undo.date}}</span><button type="button" data-action="undo" title="{{localize 'TOVF.Interface.UndoTheLastSavedCorrection_351eff'}}"><i class="fa-solid fa-rotate-left"></i> {{localize 'TOVF.Interface.Undo_b626f2'}}</button></div>{{/if}}

  {{#if (eq tab "guild")}}{{#with guildOverview}}
  <section class="tovf-gm-tools-section tovf-guild-overview">
    <div class="tovf-guild-stats"><article><span>{{localize "DOWNTIME_MANAGER.GMTools.Guild.Active"}}</span><strong>{{activeCount}}</strong><small>{{inactiveCount}} {{localize "DOWNTIME_MANAGER.GMTools.Guild.Inactive"}}</small></article><article><span>{{localize "DOWNTIME_MANAGER.GMTools.Guild.Level"}}</span><strong>{{averageLevel}}</strong><small>{{localize "DOWNTIME_MANAGER.GMTools.Guild.Median"}}: {{medianLevel}}</small></article><article class="tovf-guild-highest"><span>{{localize "DOWNTIME_MANAGER.GMTools.Guild.Highest"}}</span><strong>Level {{highestLevel}}</strong><small>Tier {{highestTier}}{{#if highestCharacterName}} &middot; {{highestCharacterName}}{{/if}}</small><img src="{{highestCharacterImg}}" alt="{{highestCharacterName}}"></article><article><span>{{localize "DOWNTIME_MANAGER.GMTools.Guild.Downtime"}}</span><strong>{{averageDowntime}}</strong><small>{{localize "DOWNTIME_MANAGER.GMTools.Guild.Median"}}: {{medianDowntime}}</small></article></div>
    <details open><summary>{{localize "DOWNTIME_MANAGER.GMTools.Guild.Tiers"}}</summary><div class="tovf-guild-bars">{{#each tierBars}}<div><span>{{label}}</span><div><i style="width: {{percent}}%"></i></div><strong>{{count}}</strong></div>{{/each}}</div></details>
    <details open><summary>{{localize "DOWNTIME_MANAGER.GMTools.Guild.Classes"}}</summary><p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.Guild.ClassesHint"}}</p><div class="tovf-guild-bars">{{#each classBars}}<div><span>{{label}}</span><div><i style="width: {{percent}}%"></i></div><strong>{{count}}</strong></div>{{else}}<p class="notes">{{localize "DOWNTIME_MANAGER.Common.None"}}</p>{{/each}}</div></details>
    <details open><summary>{{localize "DOWNTIME_MANAGER.GMTools.Guild.SessionActivity"}}</summary><p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.Guild.SessionHint"}}</p><div class="tovf-guild-bars tovf-guild-weeks">{{#each sessionBars}}<div title="{{sessions}} Sessions"><span>{{label}}</span><div><i style="width: {{percent}}%"></i></div><strong>{{count}}</strong></div>{{/each}}</div></details>
  </section>
  {{/with}}{{/if}}

  {{#if (eq tab "characters")}}
  <section class="tovf-gm-tools-section">
    <details class="tovf-gm-milestone-audit">
      <summary><i class="fa-solid fa-scale-unbalanced"></i> {{localize "DOWNTIME_MANAGER.GMTools.MilestoneAudit.Title"}} <small>({{milestoneMismatches.length}})</small></summary>
      <p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.MilestoneAudit.Hint"}}</p>
      <div class="tovf-gm-milestone-audit-list">{{#each milestoneMismatches}}<article><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{localize "DOWNTIME_MANAGER.GMTools.MilestoneAudit.Values" milestones=milestones actual=actualLevel expected=expectedLevel}}</small></span><button type="button" data-action="openDocument" data-uuid="{{uuid}}" title="{{localize 'DOWNTIME_MANAGER.GMTools.OpenSheet'}}"><i class="fa-solid fa-arrow-up-right-from-square"></i></button></article>{{else}}<p class="tovf-gm-ok"><i class="fa-solid fa-circle-check"></i> {{localize "DOWNTIME_MANAGER.GMTools.MilestoneAudit.NoMismatches"}}</p>{{/each}}</div>
    </details>
    {{#if selected}}
    <div data-character-editor>
      <div class="tovf-gm-character-title"><img src="{{selected.img}}" alt=""><label class="tovf-gm-character-name"><span>{{localize "DOWNTIME_MANAGER.GMTools.Player"}}</span><select data-character-select aria-label="{{localize 'DOWNTIME_MANAGER.GMTools.Character'}}">{{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><button type="button" data-action="openDocument" data-uuid="{{selected.uuid}}"><i class="fa-solid fa-user"></i> {{localize "DOWNTIME_MANAGER.GMTools.OpenSheet"}}</button>
        <div class="tovf-gm-header-session-fields">
          <label><span>{{localize "DOWNTIME_MANAGER.GMTools.SessionsPlayed"}}</span><input type="number" name="sessionsPlayed" min="0" step="1" value="{{selected.sessionsPlayed}}"></label>
          <label><span>{{localize "DOWNTIME_MANAGER.GMTools.LastMilestoneWeek"}}</span><input type="text" name="lastMilestoneWeek" value="{{selected.lastMilestoneWeek}}" placeholder="2026-W32"></label>
          <label class="checkbox"><span>{{localize "DOWNTIME_MANAGER.GMTools.CharacterActive"}}</span><input type="checkbox" name="characterActive" {{checked selected.active}}></label>
        </div>
      </div>
      <div class="tovf-gm-character-overview">
        <fieldset class="tovf-gm-milestones">
          <legend>{{localize "DOWNTIME_MANAGER.GMTools.Milestones"}} <span class="tovf-gm-milestone-total" data-milestone-total>{{selected.milestones}}</span><span class="tovf-gm-milestone-level-label">&nbsp;&ndash; {{localize "DOWNTIME_MANAGER.Session.Level"}}</span><span class="tovf-gm-milestone-total" data-milestone-level>{{selected.milestoneLevel}}</span></legend>
          <div class="tovf-gm-milestone-scroll">
            <table class="tovf-gm-milestone-table">
              <colgroup><col class="milestone-number"><col class="milestone-source"><col class="milestone-evidence"><col class="milestone-note"><col class="milestone-week"><col class="milestone-actions"></colgroup>
              <thead><tr><th scope="col">#</th><th scope="col">{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Source"}}</th><th scope="col">{{localize 'TOVF.Interface.Evidence_c5d55b'}}</th><th scope="col">{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Reason"}}</th><th scope="col">{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Week"}}</th><th scope="col"><span class="tovf-gm-sr-only">{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Actions"}}</span></th></tr></thead>
              <tbody data-milestone-changes>
                {{#each selected.milestoneEntries}}
                  <tr data-milestone-row data-original-index="{{originalIndex}}">
                    <td class="tovf-gm-milestone-number" data-milestone-number>{{number}}</td>
                    <td><select name="milestoneSource" aria-label="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Source"}}"><option value="start" {{#if (eq source "start")}}selected{{/if}}>{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Types.start"}}</option><option value="session" {{#if (eq source "session")}}selected{{/if}}>{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Types.session"}}</option><option value="community" {{#if (eq source "community")}}selected{{/if}}>{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Types.community"}}</option><option value="gm" {{#if (eq source "gm")}}selected{{/if}}>{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Types.gm"}}</option><option value="correction" {{#if (eq source "correction")}}selected{{/if}}>{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Types.correction"}}</option></select></td>
                    <td><select name="milestoneEvidence" data-evidence-key="{{evidenceKey}}" aria-label="{{localize 'TOVF.Interface.SelectEvidence_ab2eb6'}}"></select></td><td><input type="text" name="milestoneNote" value="{{note}}" placeholder="{{localize 'TOVF.Interface.AdditionalNoteManualReason_f08a2e'}}" aria-label="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Reason"}}"></td>
                    <td><input type="text" name="milestoneWeek" value="{{week}}" placeholder="2026-W32" aria-label="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Week"}}"></td>
                    <td><div class="tovf-gm-milestone-actions"><button type="button" data-action="moveMilestoneRow" data-direction="up" title="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.MoveUp"}}" aria-label="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.MoveUp"}}"><i class="fa-solid fa-arrow-up"></i></button><button type="button" data-action="moveMilestoneRow" data-direction="down" title="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.MoveDown"}}" aria-label="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.MoveDown"}}"><i class="fa-solid fa-arrow-down"></i></button><button type="button" data-action="removeMilestoneRow" title="{{localize 'DOWNTIME_MANAGER.GMTools.Remove'}}" aria-label="{{localize 'DOWNTIME_MANAGER.GMTools.Remove'}}"><i class="fa-solid fa-trash"></i></button></div></td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
          <template data-milestone-template>                <tr data-milestone-row data-original-index="">
                    <td class="tovf-gm-milestone-number" data-milestone-number></td>
                    <td><select name="milestoneSource" aria-label="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Source"}}"><option value="start" >{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Types.start"}}</option><option value="session" >{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Types.session"}}</option><option value="community" >{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Types.community"}}</option><option value="gm" >{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Types.gm"}}</option><option value="correction" >{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Types.correction"}}</option></select></td>
                    <td><select name="milestoneEvidence" data-evidence-key="" aria-label="{{localize 'TOVF.Interface.SelectEvidence_ab2eb6'}}"></select></td><td><input type="text" name="milestoneNote" value="" placeholder="{{localize 'TOVF.Interface.AdditionalNoteManualReason_f08a2e'}}" aria-label="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Reason"}}"></td>
                    <td><input type="text" name="milestoneWeek" value="" placeholder="2026-W32" aria-label="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.Week"}}"></td>
                    <td><div class="tovf-gm-milestone-actions"><button type="button" data-action="moveMilestoneRow" data-direction="up" title="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.MoveUp"}}" aria-label="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.MoveUp"}}"><i class="fa-solid fa-arrow-up"></i></button><button type="button" data-action="moveMilestoneRow" data-direction="down" title="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.MoveDown"}}" aria-label="{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.MoveDown"}}"><i class="fa-solid fa-arrow-down"></i></button><button type="button" data-action="removeMilestoneRow" title="{{localize 'DOWNTIME_MANAGER.GMTools.Remove'}}" aria-label="{{localize 'DOWNTIME_MANAGER.GMTools.Remove'}}"><i class="fa-solid fa-trash"></i></button></div></td>
                  </tr></template>
          <button type="button" data-action="addMilestoneRow"><i class="fa-solid fa-plus"></i> {{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.AddRow"}}</button>
        </fieldset>
      </div>
      <footer class="form-footer tovf-gm-character-footer"><button type="button" data-action="exportCharacter"><i class="fa-solid fa-download"></i> {{localize "DOWNTIME_MANAGER.GMTools.Export"}}</button><button type="button" data-action="saveCharacter"><i class="fa-solid fa-floppy-disk"></i> {{localize "DOWNTIME_MANAGER.GMTools.SaveCharacter"}}</button></footer>
    </div>
    {{else}}<p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.NoCharacters"}}</p>{{/if}}
  </section>
  {{/if}}

  {{#if (eq tab "activity")}}
  <section class="tovf-gm-tools-section">
    <h2>{{localize "DOWNTIME_MANAGER.GMTools.Activity.Title"}}</h2>
    <p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.Activity.Hint"}}</p>
    <div class="tovf-activity-filters"><label>{{localize "DOWNTIME_MANAGER.GMTools.Activity.Sort"}}<select data-activity-sort><option value="session">{{localize "DOWNTIME_MANAGER.GMTools.Activity.SortSession"}}</option><option value="login">{{localize "DOWNTIME_MANAGER.GMTools.Activity.SortLogin"}}</option><option value="name">{{localize "DOWNTIME_MANAGER.GMTools.Activity.SortName"}}</option></select></label><label>{{localize "DOWNTIME_MANAGER.GMTools.Activity.LoginFilter"}}<select data-activity-login><option value="all">{{localize "DOWNTIME_MANAGER.GMTools.Activity.All"}}</option><option value="recent">{{localize "DOWNTIME_MANAGER.GMTools.Activity.WithinWeek"}}</option><option value="older">{{localize "DOWNTIME_MANAGER.GMTools.Activity.Older"}}</option><option value="unknown">{{localize "DOWNTIME_MANAGER.GMTools.Activity.Unknown"}}</option></select></label></div>
    <h3>{{localize "DOWNTIME_MANAGER.GMTools.Activity.ActiveList"}}</h3>
    <div class="tovf-activity-table"><table><thead><tr><th>{{localize "DOWNTIME_MANAGER.GMTools.Activity.Character"}}</th><th>{{localize "DOWNTIME_MANAGER.GMTools.Activity.LastSession"}}</th><th>{{localize "DOWNTIME_MANAGER.GMTools.Activity.LastLogin"}}</th><th>{{localize "DOWNTIME_MANAGER.GMTools.Activity.ActiveColumn"}}</th></tr></thead><tbody data-activity-body>{{#each activityActiveActors}}<tr data-activity-row data-name="{{sortName}}" data-session-at="{{sessionAt}}" data-login-at="{{lastLoginAt}}" data-login-group="{{loginGroup}}"><td><img src="{{img}}" alt=""><strong>{{name}}</strong></td><td><strong>{{lastSessionTitle}}</strong>{{#if lastSessionDate}}<small>{{lastSessionDate}}</small>{{/if}}</td><td>{{lastLogin}}</td><td><input type="checkbox" name="characterActivity" value="{{uuid}}" checked></td></tr>{{else}}<tr><td colspan="4" class="notes">{{localize "DOWNTIME_MANAGER.GMTools.Activity.NoActive"}}</td></tr>{{/each}}</tbody></table></div>
    <h3>{{localize "DOWNTIME_MANAGER.GMTools.Activity.InactiveList"}}</h3>
    <div class="tovf-activity-table"><table><thead><tr><th>{{localize "DOWNTIME_MANAGER.GMTools.Activity.Character"}}</th><th>{{localize "DOWNTIME_MANAGER.GMTools.Activity.LastSession"}}</th><th>{{localize "DOWNTIME_MANAGER.GMTools.Activity.LastLogin"}}</th><th>{{localize "DOWNTIME_MANAGER.GMTools.Activity.ActiveColumn"}}</th></tr></thead><tbody data-activity-body>{{#each activityInactiveActors}}<tr data-activity-row data-name="{{sortName}}" data-session-at="{{sessionAt}}" data-login-at="{{lastLoginAt}}" data-login-group="{{loginGroup}}"><td><img src="{{img}}" alt=""><strong>{{name}}</strong></td><td><strong>{{lastSessionTitle}}</strong>{{#if lastSessionDate}}<small>{{lastSessionDate}}</small>{{/if}}</td><td>{{lastLogin}}</td><td><input type="checkbox" name="characterActivity" value="{{uuid}}"></td></tr>{{else}}<tr><td colspan="4" class="notes">{{localize "DOWNTIME_MANAGER.GMTools.Activity.NoInactive"}}</td></tr>{{/each}}</tbody></table></div>
    <footer class="form-footer"><button type="button" data-action="saveActivity"><i class="fa-solid fa-floppy-disk"></i> {{localize "DOWNTIME_MANAGER.GMTools.Activity.Save"}}</button></footer>
  </section>
  {{/if}}

  {{#if (eq tab "downtime")}}
  <section class="tovf-gm-tools-section">
    {{#if canSettlePassiveDowntime}}
    <h2>{{localize "DOWNTIME_MANAGER.Session.Settlement"}}</h2>
    <div class="tovf-passive-settlement"><label><span>{{localize "DOWNTIME_MANAGER.Session.PassivePeriod"}}</span>{{#if (eq settlement.period "week")}}<input type="week" name="settlementPeriod" value="{{settlement.periodKey}}">{{else}}<input type="month" name="settlementPeriod" value="{{settlement.periodKey}}">{{/if}}</label><button type="button" data-action="settlePassiveDowntime">{{localize "DOWNTIME_MANAGER.Session.Settle"}}</button></div>
    <hr>
    {{/if}}
    <h2>{{localize "DOWNTIME_MANAGER.GMTools.PassiveDowntime"}}</h2>

  {{#if selected}}<div data-downtime-editor>
    <label>{{localize 'TOVF.Interface.Character_19365b'}} <select data-character-select>{{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
            <div class="tovf-gm-character-sidebar">
        <fieldset class="tovf-gm-downtime-card">
          <legend>{{localize "DOWNTIME_MANAGER.GMTools.Downtime"}}</legend>
          <label><span>{{localize "DOWNTIME_MANAGER.Session.MilestoneOrigin.AvailableDowntime"}}</span><input type="number" name="downtime" min="0" step="any" value="{{selected.downtime}}"></label>
            <label class="tovf-gm-json-field"><span>{{localize "DOWNTIME_MANAGER.GMTools.PassiveDowntime"}}</span><textarea name="passiveDowntime" rows="4">{{selected.passiveDowntime}}</textarea></label>
        </fieldset>
  
    </div>
    <button type="button" data-action="saveDowntime">{{localize 'TOVF.Interface.SaveDowntimeCorrection_c096b6'}}</button>
  </div>{{/if}}
  <h2>{{localize "DOWNTIME_MANAGER.Dashboard.DirectDowntime"}}</h2>
  {{#if dashboard.hasInactiveCharacters}}<div class="sc-section-actions"><button type="button" data-action="toggleInactiveDowntime"><i class="fa-solid fa-eye"></i> {{#if dashboard.showInactiveCharacters}}{{localize "DOWNTIME_MANAGER.GMTools.Activity.HideInactive"}}{{else}}{{localize "DOWNTIME_MANAGER.GMTools.Activity.ShowInactive"}}{{/if}}</button></div>{{/if}}
  {{#with dashboard}}  <details class="sc-dashboard-downtime" open><summary>{{localize "DOWNTIME_MANAGER.Dashboard.DirectDowntime"}}</summary><div class="sc-dashboard-downtime-body"><div class="sc-dashboard-character-grid">{{#each characters}}<label class="checkbox"><input type="checkbox" name="directDowntimeActors" value="{{uuid}}"><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{localize "DOWNTIME_MANAGER.Dashboard.CurrentDowntime"}}: {{downtime}}</small></span></label>{{else}}<p class="notes">{{localize "DOWNTIME_MANAGER.Dashboard.Errors.NoCharacters"}}</p>{{/each}}</div><div class="sc-dashboard-grant-actions"><label><span>{{localize "DOWNTIME_MANAGER.Dashboard.Amount"}}</span><input type="number" name="directDowntimeAmount" value="1" min="0.000001" step="any"></label><button type="button" data-action="grantSelectedDowntime"><i class="fa-solid fa-user-check"></i> {{localize "DOWNTIME_MANAGER.Dashboard.GrantSelected"}}</button><button type="button" data-action="grantAllDowntime"><i class="fa-solid fa-users"></i> {{localize "DOWNTIME_MANAGER.Dashboard.GrantAll"}}</button></div>{{#with lastDirectAll}}<p class="sc-dashboard-last-grant"><i class="fa-solid fa-clock-rotate-left"></i> {{localize "DOWNTIME_MANAGER.Dashboard.LastGrantAll"}}: <strong>{{date}}</strong> &middot; {{amount}} {{localize "DOWNTIME_MANAGER.Station.Downtime"}} &middot; {{count}} {{localize "DOWNTIME_MANAGER.Dashboard.Characters"}}{{#if userName}} &middot; {{userName}}{{/if}}</p>{{/with}}</div></details>
{{/with}}
  </section>
  {{/if}}
  {{#if (eq tab "projects")}}

  <section class="tovf-gm-tools-section sc-dashboard-body"><div class="tovf-gm-project-header">  <div class="sc-section-actions"><button type="button" data-action="openProjectLibrary">{{localize "DOWNTIME_MANAGER.ProjectLibrary.Title"}}</button><button type="button" data-action="openStationPresets">{{localize "DOWNTIME_MANAGER.StationPresets.Title"}}</button><button type="button" data-action="openSessions">{{localize "DOWNTIME_MANAGER.Session.Title"}}</button></div>{{#with dashboard}}  <div class="sc-dashboard-summary">
    <span><strong>{{localize "DOWNTIME_MANAGER.Dashboard.Stations"}}:</strong> {{stations.length}}</span>
    <span><strong>{{localize "DOWNTIME_MANAGER.Dashboard.Active"}}:</strong> {{activeCount}}</span>
    <span><strong>{{localize "DOWNTIME_MANAGER.Dashboard.PendingRolls"}}:</strong> {{rollCount}}</span>
    <span><strong>{{localize "DOWNTIME_MANAGER.Dashboard.Completed"}}:</strong> {{completedCount}}</span>
  </div>
</div>
  <details class="sc-dashboard-projects" open><summary>{{localize "DOWNTIME_MANAGER.Dashboard.ProjectOverview"}}</summary><div class="sc-dashboard-projects-body"><div class="sc-dashboard-stations">{{#each stations}}<button type="button" data-action="openStation" data-uuid="{{uuid}}" {{#unless enabled}}class="disabled"{{/unless}}><i class="fa-solid fa-screwdriver-wrench"></i> {{name}}</button>{{/each}}</div>
  <div class="sc-dashboard-table">
    <div class="sc-dashboard-row header"><span>{{localize "DOWNTIME_MANAGER.Dashboard.Character"}}</span><span>{{localize "DOWNTIME_MANAGER.Dashboard.Station"}}</span><span>{{localize "DOWNTIME_MANAGER.Dashboard.Project"}}</span><span>{{localize "DOWNTIME_MANAGER.Dashboard.Progress"}}</span><span>{{localize "DOWNTIME_MANAGER.Dashboard.StatusLabel"}}</span><span></span></div>
    {{#each rows}}<div class="sc-dashboard-row"><span class="sc-dashboard-actor"><img src="{{actorImg}}" alt="">{{actorName}}</span><span>{{#if stationAvailable}}<button type="button" data-action="openStation" data-uuid="{{stationUuid}}">{{stationName}}</button>{{else}}{{stationName}}{{/if}}</span><span>{{projectName}}</span><span><progress max="100" value="{{percent}}"></progress><small>{{progress}} / {{requiredProgress}} ({{percent}}%)</small></span><span class="status {{status}}">{{statusLabel}}</span><button type="button" class="danger sc-dashboard-remove" data-action="removeDashboardProject" data-actor-uuid="{{actorUuid}}" data-state-id="{{stateId}}" data-station-uuid="{{stationUuid}}" data-project-uuid="{{projectUuid}}" data-project-name="{{projectName}}" title="{{localize 'DOWNTIME_MANAGER.Dashboard.RemoveProject'}}"><i class="fa-solid fa-trash"></i></button></div>{{else}}<p class="notes">{{localize "DOWNTIME_MANAGER.Dashboard.Empty"}}</p>{{/each}}
  </div></div></details>
{{/with}}</section>
  <section class="tovf-gm-tools-section">
    <div class="form-group"><label>{{localize "DOWNTIME_MANAGER.GMTools.Character"}}</label><select data-character-select>{{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
    {{#each selected.projects}}
    <article class="tovf-gm-project" data-project-row>
      <header><div><strong>{{projectName}}</strong><small>{{stationName}}</small></div><code>{{projectUuid}}</code></header>
      <div class="tovf-gm-project-values">
        <label><span>{{localize "DOWNTIME_MANAGER.GMTools.Progress"}}</span><input type="number" name="progress" min="0" step="any" value="{{progress}}"></label>
        <label><span>{{localize "DOWNTIME_MANAGER.GMTools.RequiredProgress"}}</span><input type="number" name="requiredProgress" min="0" step="any" value="{{requiredProgress}}"></label>
        <label><span>{{localize "DOWNTIME_MANAGER.GMTools.IntervalProgress"}}</span><input type="number" name="intervalProgress" min="0" step="any" value="{{intervalProgress}}"></label>
      </div>
      <div class="tovf-gm-project-flags">
        <label class="checkbox"><input type="checkbox" name="active" {{checked activeChecked}}> {{localize "DOWNTIME_MANAGER.GMTools.Active"}}</label>
        <label class="checkbox"><input type="checkbox" name="completed" {{checked completedChecked}}> {{localize "DOWNTIME_MANAGER.GMTools.Completed"}}</label>
        <label class="checkbox"><input type="checkbox" name="pendingRoll" {{checked pendingRollChecked}}> {{localize "DOWNTIME_MANAGER.GMTools.PendingRoll"}}</label>
        <label class="checkbox"><input type="checkbox" name="awaitingCompletionCheck" {{checked awaitingCompletionCheckChecked}}> {{localize "DOWNTIME_MANAGER.GMTools.AwaitingCompletion"}}</label>
      </div>
      <footer><button type="button" class="danger" data-action="removeProject" data-state-id="{{id}}"><i class="fa-solid fa-trash"></i> {{localize "DOWNTIME_MANAGER.GMTools.Remove"}}</button><button type="button" data-action="saveProject" data-state-id="{{id}}"><i class="fa-solid fa-floppy-disk"></i> {{localize "DOWNTIME_MANAGER.GMTools.SaveProject"}}</button></footer>
    </article>
    {{else}}<p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.NoProjects"}}</p>{{/each}}
  </section>
  {{/if}}

  {{#if (eq tab "session")}}
  <section class="tovf-gm-tools-section">
    <h2>{{localize "DOWNTIME_MANAGER.GMTools.SessionHistory.Title"}}</h2>
    <input type="search" data-session-history-search placeholder="{{localize 'DOWNTIME_MANAGER.GMTools.SessionHistory.Search'}}">
    <div class="tovf-session-history-table"><table><thead><tr><th>{{localize "DOWNTIME_MANAGER.GMTools.SessionHistory.Session"}}</th><th>{{localize "DOWNTIME_MANAGER.GMTools.SessionHistory.GM"}}</th><th>{{localize "DOWNTIME_MANAGER.GMTools.SessionHistory.Participants"}}</th><th>{{localize "DOWNTIME_MANAGER.GMTools.SessionHistory.Passive"}}</th><th></th></tr></thead><tbody>{{#each sessionHistory}}<tr data-session-history-row data-search="{{search}}"><td><strong>{{title}}</strong><small>{{date}}{{#if corrected}} &middot; {{localize "DOWNTIME_MANAGER.GMTools.SessionHistory.Corrected"}}{{/if}}</small></td><td>{{gmName}}</td><td>{{participantCount}}</td><td>{{passiveCount}}</td><td><button type="button" data-action="correctHistoricalSession" data-record-id="{{id}}"><i class="fa-solid fa-pen-to-square"></i> {{localize "DOWNTIME_MANAGER.GMTools.SessionHistory.Edit"}}</button></td></tr>{{else}}<tr><td colspan="5" class="notes">{{localize "DOWNTIME_MANAGER.GMTools.SessionHistory.Empty"}}</td></tr>{{/each}}</tbody></table></div>
    <details class="tovf-session-recovery"><summary>{{localize "DOWNTIME_MANAGER.GMTools.SessionHistory.Recovery"}}</summary>{{#if activeSession.empty}}<p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.NoActiveSession"}}</p>{{else}}<dl class="tovf-gm-session-summary"><dt>Status</dt><dd>{{activeSession.status}}</dd><dt>ID</dt><dd>{{activeSession.id}}</dd><dt>{{localize "DOWNTIME_MANAGER.GMTools.SessionTitle"}}</dt><dd>{{activeSession.title}}</dd></dl><details><summary>{{localize "DOWNTIME_MANAGER.GMTools.RawData"}}</summary><pre>{{activeSession.json}}</pre></details><footer class="form-footer"><button type="button" data-action="unlockSession"><i class="fa-solid fa-lock-open"></i> {{localize "DOWNTIME_MANAGER.GMTools.UnlockSession"}}</button><button type="button" class="danger" data-action="resetSession"><i class="fa-solid fa-trash"></i> {{localize "DOWNTIME_MANAGER.GMTools.ResetSession"}}</button></footer>{{/if}}</details>
  </section>
  {{/if}}

  {{#if (eq tab "database")}}
  <section class="tovf-gm-tools-section tovf-gm-database">
    <header class="tovf-gm-database-filters">
      <label><span>{{localize "DOWNTIME_MANAGER.GMTools.Database.DocumentType"}}</span><select data-database-type>{{#each database.types}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}} ({{count}})</option>{{/each}}</select></label>
      <label><span>{{localize "DOWNTIME_MANAGER.GMTools.Database.Search"}}</span><input type="search" data-database-query value="{{database.query}}" placeholder="{{localize 'DOWNTIME_MANAGER.GMTools.Database.SearchPlaceholder'}}"></label>
      <label><span>{{localize "DOWNTIME_MANAGER.GMTools.Database.Namespace"}}</span><select data-database-namespace><option value="">{{localize "DOWNTIME_MANAGER.GMTools.Database.AllNamespaces"}}</option>{{#each database.namespaces}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{id}} ({{count}})</option>{{/each}}</select></label>
      <label class="checkbox"><input type="checkbox" data-database-only-flagged {{checked database.onlyFlagged}}> {{localize "DOWNTIME_MANAGER.GMTools.Database.OnlyFlagged"}}</label>
    </header>
    <div class="tovf-gm-database-toolbar">
      <span>{{localize "DOWNTIME_MANAGER.GMTools.Database.Selected"}}: <b data-database-selection-count>{{database.selectedCount}}</b></span>
      <button type="button" data-action="selectVisibleDocuments"><i class="fa-solid fa-check-double"></i> {{localize "DOWNTIME_MANAGER.GMTools.Database.SelectVisible"}}</button>
      <button type="button" data-action="clearDocumentSelection"><i class="fa-solid fa-xmark"></i> {{localize "DOWNTIME_MANAGER.GMTools.Database.ClearSelection"}}</button>
      <button type="button" data-action="exportFlags"><i class="fa-solid fa-download"></i> {{localize "DOWNTIME_MANAGER.GMTools.Database.ExportFlags"}}</button>
    </div>
    <div class="tovf-gm-database-grid">
      <aside class="tovf-gm-database-documents">
        <h3>{{localize "DOWNTIME_MANAGER.GMTools.Database.Documents"}}</h3>
        <div class="tovf-gm-database-scroll">
          {{#each database.documents}}
          <div class="tovf-gm-database-document {{#if selected}}active{{/if}}">
            <input type="checkbox" data-database-document-check value="{{uuid}}" {{checked checked}} aria-label="{{name}}">
            <button type="button" data-action="selectDatabaseDocument" data-uuid="{{uuid}}"><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{flagCount}} Flags &middot; {{#each namespaces}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</small></span></button>
          </div>
          {{else}}<p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.Database.NoDocuments"}}</p>{{/each}}
        </div>
      </aside>
      <section class="tovf-gm-database-tree">
        <h3>{{localize "DOWNTIME_MANAGER.GMTools.Database.FlagTree"}}</h3>
        {{#if database.detail}}
        <header><strong>{{database.detail.name}}</strong><button type="button" data-action="openDocument" data-uuid="{{database.detail.uuid}}"><i class="fa-solid fa-arrow-up-right-from-square"></i></button></header>
        <div class="tovf-gm-database-scroll">
          {{#each database.detail.groups}}
          <details open><summary><i class="fa-solid fa-folder-tree"></i> {{namespace}} <small>{{count}}</small></summary>
            {{#each entries}}<button type="button" class="tovf-gm-flag-node {{#if selected}}active{{/if}}" style="--flag-indent: {{indent}}rem" data-action="selectFlag" data-address="{{address}}"><code>{{label}}</code><span>{{type}} &middot; {{summary}}</span></button>{{/each}}
          </details>
          {{else}}<p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.Database.NoFlags"}}</p>{{/each}}
        </div>
        {{else}}<p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.Database.NoDocumentSelected"}}</p>{{/if}}
      </section>
      <section class="tovf-gm-database-editor">
        <h3>{{localize "DOWNTIME_MANAGER.GMTools.Database.Editor"}}</h3>
        {{#if database.detail.selected}}
        <div data-flag-editor>
          <dl><dt>{{localize "DOWNTIME_MANAGER.GMTools.Database.Path"}}</dt><dd><code>{{database.detail.selected.address}}</code></dd><dt>{{localize "DOWNTIME_MANAGER.GMTools.Database.Summary"}}</dt><dd>{{database.detail.selected.summary}}</dd></dl>
          <label><span>{{localize "DOWNTIME_MANAGER.GMTools.Database.ValueType"}}</span><select data-flag-type>{{#each database.detail.selected.typeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label><span>{{localize "DOWNTIME_MANAGER.GMTools.Database.Value"}}</span><textarea data-flag-value rows="12">{{database.detail.selected.value}}</textarea></label>
          <p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.Database.BulkHint"}}</p>
          <footer><button type="button" class="danger" data-action="deleteFlag"><i class="fa-solid fa-trash"></i> {{localize "DOWNTIME_MANAGER.GMTools.Database.Delete"}}</button><button type="button" data-action="saveFlag"><i class="fa-solid fa-floppy-disk"></i> {{localize "DOWNTIME_MANAGER.GMTools.Database.Save"}}</button></footer>
        </div>
        {{else}}
        <p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.Database.SelectFlagHint"}}</p>
        {{/if}}
        {{#if database.detail}}
        <details class="tovf-gm-create-flag" data-create-flag><summary>{{localize "DOWNTIME_MANAGER.GMTools.Database.Create"}}</summary>
          <label><span>{{localize "DOWNTIME_MANAGER.GMTools.Database.Namespace"}}</span><input name="namespace" type="text" placeholder="tov-feuerschwinge-tools"></label>
          <label><span>{{localize "DOWNTIME_MANAGER.GMTools.Database.Path"}}</span><input name="path" type="text" placeholder="example.enabled"></label>
          <label><span>{{localize "DOWNTIME_MANAGER.GMTools.Database.ValueType"}}</span><select name="type"><option value="string">string</option><option value="number">number</option><option value="boolean">boolean</option><option value="null">null</option><option value="object">object</option><option value="array">array</option></select></label>
          <label><span>{{localize "DOWNTIME_MANAGER.GMTools.Database.Value"}}</span><textarea name="value" rows="5"></textarea></label>
          <button type="button" data-action="createFlag"><i class="fa-solid fa-plus"></i> {{localize "DOWNTIME_MANAGER.GMTools.Database.Create"}}</button>
        </details>
        {{/if}}
      </section>
    </div>
  </section>
  {{/if}}

  {{#if (eq tab "voidTaint")}}
  <section class="tovf-gm-tools-section">
    <div class="tovf-void-taint-heading"><div><h2>{{localize "TOVF.VoidTaint.GMTools.Title"}}</h2><p class="notes">{{localize "TOVF.VoidTaint.GMTools.Hint"}}</p></div><button type="button" data-action="openVoidTaintConfig"><i class="fa-solid fa-gear"></i> {{localize "TOVF.VoidTaint.GMTools.Settings"}}</button></div>
    {{#if voidTaintEnabled}}
    <div class="tovf-void-taint-list">
      {{#each voidTaint}}
      <article class="tovf-void-taint-row" data-void-taint-row>
        <img src="{{img}}" alt=""><div class="grow"><strong>{{name}}</strong><small>{{localize "TOVF.VoidTaint.GMTools.Threshold"}}: {{threshold}}</small></div>
        <button type="button" data-action="changeVoidTaint" data-uuid="{{uuid}}" data-amount="-1" title="-1"><i class="fa-solid fa-minus"></i></button>
        <input type="number" name="voidTaint" min="0" step="1" value="{{value}}" aria-label="Void Taint">
        <button type="button" data-action="changeVoidTaint" data-uuid="{{uuid}}" data-amount="1" title="+1"><i class="fa-solid fa-plus"></i></button>
        <button type="button" data-action="setVoidTaint" data-uuid="{{uuid}}"><i class="fa-solid fa-floppy-disk"></i></button>
        <button type="button" data-action="drawVoidEffect" data-kind="dread" title="{{localize 'TOVF.VoidTaint.Tables.Dread'}}"><i class="fa-solid fa-brain"></i></button>
        <button type="button" data-action="drawVoidEffect" data-kind="fleshWarp" title="{{localize 'TOVF.VoidTaint.Tables.FleshWarp'}}"><i class="fa-solid fa-dna"></i></button>
      </article>
      {{else}}<p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.NoCharacters"}}</p>{{/each}}
    </div>
    {{else}}<p class="notification warning">{{localize "TOVF.VoidTaint.GMTools.Disabled"}}</p>{{/if}}
  </section>
  {{/if}}

  {{#if (eq tab "diagnostics")}}
  <section class="tovf-gm-tools-section">
    <div class="tovf-gm-diagnostics-heading"><div><h2>{{localize "DOWNTIME_MANAGER.GMTools.Diagnostics.Title"}}</h2><p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.Diagnostics.Hint"}}</p></div><button type="button" data-action="repairSafe" {{#unless hasDiagnostics}}disabled{{/unless}}><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "DOWNTIME_MANAGER.GMTools.Diagnostics.RepairSafe"}}</button></div>
    {{#each diagnostics}}<div class="tovf-gm-problem"><i class="fa-solid fa-triangle-exclamation"></i><span>{{#if actorName}}<strong>{{actorName}}:</strong> {{/if}}{{label}}</span>{{#if actorUuid}}<button type="button" data-action="openDocument" data-uuid="{{actorUuid}}"><i class="fa-solid fa-arrow-up-right-from-square"></i></button>{{/if}}</div>{{else}}<p class="tovf-gm-ok"><i class="fa-solid fa-circle-check"></i> {{localize "DOWNTIME_MANAGER.GMTools.Diagnostics.NoProblems"}}</p>{{/each}}
    {{#if effectPackMigration.available}}<div class="tovf-gm-diagnostics-heading"><div><h3>Kopien aus &bdquo;Funktioniere Effekte&ldquo; ersetzen</h3><p class="notes">Sucht ausschlie&szlig;lich nach Verwendungen von <code>world.funktioniere-effekte</code> und ersetzt diese Referenzen durch die gleichnamigen Originaleffekte aus <code>black-flag.effects</code>. Danach wird das Kopien-Kompendium gel&ouml;scht.</p>{{#if effectPackMigration.result}}<p class="notification info"><i class="fa-solid fa-circle-check"></i> {{effectPackMigration.result}}</p>{{/if}}</div><button type="button" data-action="migrateWorkingEffects"><i class="fa-solid fa-arrow-right-arrow-left"></i> Kopien austauschen</button></div>{{/if}}
    {{#if legacyActiveEffects.available}}<div class="tovf-gm-diagnostics-heading"><div><h3>Veraltete Active Effects</h3><p class="notes"><strong>{{legacyActiveEffects.count}}</strong> Effects verwenden in ihren gespeicherten Rohdaten noch <code>type: standard</code>. Davon sind <strong>{{legacyActiveEffects.repairable}}</strong> in Weltdokumenten oder bearbeitbaren Weltkompendien und <strong>{{legacyActiveEffects.readOnly}}</strong> in schreibgesch&uuml;tzten Kompendien.</p>{{#if legacyActiveEffects.count}}<details><summary>Gefundene Quellen</summary><ul>{{#each legacyActiveEffects.sources}}<li>{{label}}: <strong>{{count}}</strong>{{#unless repairable}} <span class="notes">(nur Anzeige)</span>{{/unless}}</li>{{/each}}</ul></details>{{/if}}<p class="notes">Black-Flag- und andere Modulkompendien werden nicht ver&auml;ndert. Beim Sessiontransfer werden ihre Daten weiterhin nur in der exportierten Kopie kompatibel gemacht.</p>{{#if legacyActiveEffects.result}}<p class="notification info"><i class="fa-solid fa-circle-check"></i> {{legacyActiveEffects.result}}</p>{{/if}}</div><div class="tovf-gm-diagnostics-actions"><button type="button" data-action="repairLegacyActiveEffect"><i class="fa-solid fa-wrench"></i> Effect-UUID reparieren</button><button type="button" data-action="migrateLegacyActiveEffects" {{#unless legacyActiveEffects.repairable}}disabled{{/unless}}><i class="fa-solid fa-wand-magic-sparkles"></i> Zu base migrieren</button></div></div>{{/if}}
    <hr>
    <div class="tovf-gm-diagnostics-heading"><div><h3>{{effectCleanup.title}}</h3><p class="notes">{{effectCleanup.summary}}</p><p class="notes">{{effectCleanup.scope}}</p>{{#if effectCleanup.result}}<p class="notification info"><i class="fa-solid fa-circle-check"></i> {{effectCleanup.result}}</p>{{/if}}</div><button type="button" data-action="deleteExpiredEffects" {{#unless effectCleanup.count}}disabled{{/unless}}><i class="fa-solid fa-trash-can"></i> {{effectCleanup.action}}</button></div>
    {{#if legacyEffectFormulas.actors}}
    <div class="tovf-gm-diagnostics-heading"><div><h3>{{localize "DOWNTIME_MANAGER.GMTools.Diagnostics.LegacyFormulasTitle"}}</h3><p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.Diagnostics.LegacyFormulasHint"}}</p><p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.Diagnostics.LegacyFormulasSummary" advancementChanges=legacyEffectFormulas.advancementChanges advancementItems=legacyEffectFormulas.advancementItems changes=legacyEffectFormulas.changes types=legacyEffectFormulas.types actors=legacyEffectFormulas.actors}}</p></div></div>
    {{#each legacyEffectFormulas.groups}}<details class="tovf-gm-formula-source" open><summary><strong>{{sourceName}}</strong> <span>{{entries.length}} &times; &middot; {{actors}} Actors</span>{{#if sourceId}}<code>{{sourceId}}</code>{{/if}}</summary>{{#each entries}}<div class="tovf-gm-problem"><i class="fa-solid fa-triangle-exclamation"></i><span><strong>{{actorName}} &middot; {{location}}</strong><br><code>{{path}}</code>: <code>{{formula}}</code><br><small>{{localize "DOWNTIME_MANAGER.GMTools.Diagnostics.LegacyReferences" references=references}}</small></span><button type="button" data-action="openDocument" data-uuid="{{documentUuid}}" title="{{localize "DOWNTIME_MANAGER.GMTools.Diagnostics.OpenAffectedDocument"}}"><i class="fa-solid fa-pen-to-square"></i></button></div>{{/each}}</details>{{/each}}
    {{/if}}
    <hr>
    <div class="tovf-gm-diagnostics-heading"><div><h2>{{localize "TOVF.TechnicalDiagnostics.Title"}}</h2><p class="notes">{{localize "TOVF.TechnicalDiagnostics.Hint"}}</p></div></div>
    <div class="tovf-technical-summary">
      <article class="{{technicalDiagnostics.startupClass}}"><i class="fa-solid fa-power-off"></i><span>{{localize "TOVF.TechnicalDiagnostics.Startup"}}</span><strong>{{technicalDiagnostics.startupSummary}}</strong></article>
      <article class="{{technicalDiagnostics.compatibilityClass}}"><i class="fa-solid fa-puzzle-piece"></i><span>{{localize "TOVF.TechnicalDiagnostics.Compatibility"}}</span><strong>{{technicalDiagnostics.compatibilitySummary}}</strong></article>
      <article class="{{technicalDiagnostics.scheduler.statusClass}}"><i class="fa-solid fa-clock-rotate-left"></i><span>{{localize "TOVF.TechnicalDiagnostics.ResponsibleGM"}}</span><strong>{{technicalDiagnostics.scheduler.responsibleGM}}</strong></article>
    </div>
    <div class="tovf-technical-details">
      <details><summary>{{localize "TOVF.TechnicalDiagnostics.Startup"}}</summary><table><thead><tr><th>{{localize "TOVF.TechnicalDiagnostics.Component"}}</th><th>{{localize "TOVF.TechnicalDiagnostics.Status"}}</th><th>{{localize "TOVF.TechnicalDiagnostics.Duration"}}</th></tr></thead><tbody>{{#each technicalDiagnostics.startup}}<tr class="{{statusClass}}"><td><code>{{id}}</code>{{#if detail}}<small>{{detail}}</small>{{/if}}</td><td>{{status}}</td><td>{{duration}}</td></tr>{{else}}<tr><td colspan="3">{{localize "TOVF.TechnicalDiagnostics.NoEntries"}}</td></tr>{{/each}}</tbody></table></details>
      <details><summary>{{localize "TOVF.TechnicalDiagnostics.Compatibility"}}</summary><table><thead><tr><th>{{localize "TOVF.TechnicalDiagnostics.Component"}}</th><th>{{localize "TOVF.TechnicalDiagnostics.Status"}}</th><th>{{localize "TOVF.TechnicalDiagnostics.Duration"}}</th></tr></thead><tbody>{{#each technicalDiagnostics.compatibility}}<tr class="{{statusClass}}"><td><code>{{id}}</code>{{#if detail}}<small>{{detail}}</small>{{/if}}</td><td>{{status}}</td><td>{{duration}}</td></tr>{{else}}<tr><td colspan="3">{{localize "TOVF.TechnicalDiagnostics.NoEntries"}}</td></tr>{{/each}}</tbody></table></details>
      <details><summary>{{localize "TOVF.TechnicalDiagnostics.Scheduler"}}</summary><p class="notes">{{localize "TOVF.TechnicalDiagnostics.ResponsibleGM"}}: <strong>{{technicalDiagnostics.scheduler.responsibleGM}}</strong></p><table><thead><tr><th>{{localize "TOVF.TechnicalDiagnostics.Task"}}</th><th>{{localize "TOVF.TechnicalDiagnostics.LastRun"}}</th><th>{{localize "TOVF.TechnicalDiagnostics.NextRun"}}</th></tr></thead><tbody>{{#each technicalDiagnostics.scheduler.tasks}}<tr class="{{statusClass}}"><td><code>{{id}}</code>{{#if error}}<small>{{error}}</small>{{/if}}</td><td>{{lastRun}}</td><td>{{nextRun}}</td></tr>{{else}}<tr><td colspan="3">{{localize "TOVF.TechnicalDiagnostics.NoEntries"}}</td></tr>{{/each}}</tbody></table></details>
    </div>
    <hr>
    <div class="tovf-gm-diagnostics-heading"><div><h2>{{localize "DOWNTIME_MANAGER.GMTools.SpellMigration.Title"}}</h2><p class="notes">{{localize "DOWNTIME_MANAGER.GMTools.SpellMigration.Hint"}}</p></div><button type="button" data-action="migrateActorSpells"><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "DOWNTIME_MANAGER.GMTools.SpellMigration.Action"}}</button></div>
  </section>
  {{/if}}
</div>
