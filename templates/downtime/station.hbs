<div class="sc-body">
  <div class="sc-title-row"><div><h2>{{stationName}}</h2>{{#if stationDescription}}<p>{{stationDescription}}</p>{{/if}}</div>{{#if isGM}}<button type="button" data-action="configure"><i class="fa-solid fa-gear"></i> {{localize "DOWNTIME_MANAGER.Actions.Configure"}}</button>{{/if}}</div>
  {{#if disabled}}<p class="notification warning">{{localize "DOWNTIME_MANAGER.Station.Disabled"}}</p>{{/if}}
  {{#if noActor}}<p>{{localize "DOWNTIME_MANAGER.Station.SelectCrafter"}}</p>{{else}}
    <div class="sc-summary"><span><strong>{{localize "DOWNTIME_MANAGER.Station.Crafter"}}:</strong> {{actorName}}</span><span><strong>{{localize "DOWNTIME_MANAGER.Station.Downtime"}}:</strong> {{downtime}}</span>{{#if showGold}}<span><strong>{{localize "DOWNTIME_MANAGER.Station.Gold"}}:</strong> {{gold}} {{localize "DOWNTIME_MANAGER.Currency.GP"}}</span>{{/if}}{{#if actorValueEnabled}}<span><strong>{{actorValueLabel}}:</strong> {{actorValue}}</span>{{/if}}</div>
    <section class="sc-project-catalog" data-project-catalog>
      <div class="sc-project-catalog-heading"><h3>{{localize "DOWNTIME_MANAGER.Station.Projects"}}</h3><span class="notes">{{projects.length}} {{localize "DOWNTIME_MANAGER.Catalog.Entries"}}</span></div>
      <div class="sc-project-filters">
        <label class="sc-project-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-project-filter="search" placeholder="{{localize "DOWNTIME_MANAGER.Catalog.Search"}}"></label>
        <select data-project-filter="status" aria-label="{{localize "DOWNTIME_MANAGER.Catalog.Status"}}"><option value="all">{{localize "DOWNTIME_MANAGER.Catalog.AllStatuses"}}</option><option value="active">{{localize "DOWNTIME_MANAGER.Catalog.Active"}}</option><option value="available">{{localize "DOWNTIME_MANAGER.Catalog.Available"}}</option><option value="completed">{{localize "DOWNTIME_MANAGER.Catalog.Completed"}}</option></select>
        <select data-project-filter="type" aria-label="{{localize "DOWNTIME_MANAGER.Catalog.ItemType"}}"><option value="">{{localize "DOWNTIME_MANAGER.Catalog.AllTypes"}}</option>{{#each projectTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
        <select data-project-filter="subtype" aria-label="{{localize "DOWNTIME_MANAGER.Catalog.ItemSubtype"}}"><option value="">{{localize "DOWNTIME_MANAGER.Catalog.AllSubtypes"}}</option></select>
      </div>
      <div class="sc-list">{{#each projects}}
      <details class="sc-project {{#if completed}}completed{{/if}}" data-project-entry data-project-type="{{classification.type}}" data-project-subtype="{{classification.subtype}}" data-project-subtype-label="{{classification.subtypeLabel}}" data-project-status="{{projectStatus}}" data-project-search="{{searchText}}" {{#if expanded}}open{{/if}}>
        <summary class="sc-project-main"><img src="{{img}}" alt=""><span class="sc-project-content"><span class="sc-project-heading"><strong>{{name}}</strong>{{#if personal}} · {{localize "DOWNTIME_MANAGER.Project.Personal"}}{{/if}}{{#if repeatable}} · {{localize "DOWNTIME_MANAGER.Project.Repeatable"}}{{/if}}{{#if showGoldCost}}<span class="sc-project-cost"><strong>{{localize "DOWNTIME_MANAGER.Project.UnitCost"}}:</strong> {{goldCost}} {{localize "DOWNTIME_MANAGER.Currency.GP"}}</span>{{/if}}</span><span class="sc-project-classification">{{classification.typeLabel}}{{#if classification.subtypeLabel}} · {{classification.subtypeLabel}}{{/if}}</span>{{#if active}}<span class="sc-project-compact-progress"><progress max="{{requiredProgress}}" value="{{progress}}"></progress><small>{{progress}} / {{requiredProgress}}</small></span>{{/if}}</span></summary>
        <div class="sc-project-details">{{#if description}}<div class="notes sc-project-description">{{{description}}}</div>{{/if}}

        <div class="sc-project-progress-actions">
          {{#if collaborative}}
            {{#if sharedState}}
              <div class="sc-project-progress"><div>{{sharedProgress}} / {{sharedRequiredProgress}} ({{sharedPercent}}%)</div><progress max="{{sharedRequiredProgress}}" value="{{sharedProgress}}"></progress></div>
              <div class="sc-shared-participants"><strong>{{localize "DOWNTIME_MANAGER.Project.Participants"}}:</strong> {{#each sharedParticipants}}<span class="sc-category-chip">{{#if leader}}<i class="fa-solid fa-crown"></i>{{/if}} {{name}} · {{contribution.progress}}</span>{{/each}}</div>
              {{#if sharedJoined}}
                {{#if sharedState.awaitingCompletionCheck}}<select data-shared-completion-check-for="{{uuid}}">{{#each checks}}<option value="{{id}}">{{label}}</option>{{/each}}</select><button type="button" data-action="sharedCompletionRoll" data-uuid="{{uuid}}"><i class="fa-solid fa-flag-checkered"></i> {{localize "DOWNTIME_MANAGER.Project.RollCompletionCheck"}}</button>
                {{else}}{{#if sharedState.pendingRoll}}<select data-shared-check-for="{{uuid}}" {{#unless sharedCanRoll}}disabled{{/unless}}>{{#each checks}}<option value="{{id}}">{{label}}</option>{{/each}}</select><button type="button" data-action="sharedRoll" data-uuid="{{uuid}}" {{#unless sharedCanRoll}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i> {{localize "DOWNTIME_MANAGER.Actions.Roll"}}</button>
                {{else}}{{#if showCheckSelection}}<select data-shared-check-for="{{uuid}}">{{#each checks}}<option value="{{id}}">{{label}}</option>{{/each}}</select>{{/if}}<input class="sc-downtime-input" type="number" data-shared-downtime-for="{{uuid}}" value="{{sharedInvestmentDefault}}" min="0.000001" max="{{sharedMaxInvestment}}" step="any"><button type="button" data-action="sharedInvest" data-uuid="{{uuid}}" {{#unless sharedMaxInvestment}}disabled{{/unless}}>{{localize "DOWNTIME_MANAGER.Project.Contribute"}}</button>{{/if}}{{/if}}
                {{#if sharedLeader}}<button type="button" data-action="sharedCancel" data-uuid="{{uuid}}" class="sc-deactivate-project"><i class="fa-solid fa-ban"></i> {{localize "DOWNTIME_MANAGER.Actions.Cancel"}}</button>{{else}}<button type="button" data-action="sharedLeave" data-uuid="{{uuid}}"><i class="fa-solid fa-person-walking-arrow-right"></i> {{localize "DOWNTIME_MANAGER.Project.Leave"}}</button>{{/if}}
              {{else}}<button type="button" data-action="sharedJoin" data-uuid="{{uuid}}" {{#if knownSpell}}disabled title="{{localize 'DOWNTIME_MANAGER.Errors.SpellAlreadyKnown'}}"{{/if}}><i class="fa-solid fa-people-group"></i> {{localize "DOWNTIME_MANAGER.Project.Join"}}</button>{{/if}}
            {{else}}<label class="sc-quantity-control"><span>{{localize "DOWNTIME_MANAGER.Project.Quantity"}}</span><input type="number" data-shared-quantity-for="{{uuid}}" value="1" min="1" step="1"></label><button type="button" data-action="sharedStart" data-uuid="{{uuid}}" {{#unless canStart}}disabled{{/unless}}><i class="fa-solid fa-people-group"></i> {{localize "DOWNTIME_MANAGER.Project.StartShared"}}</button>{{/if}}
          {{else}}
          {{#if active}}<div class="sc-project-progress"><div>{{progress}} / {{requiredProgress}} ({{percent}}%)</div><progress max="{{requiredProgress}}" value="{{progress}}"></progress><small class="notes">{{localize "DOWNTIME_MANAGER.Station.Interval"}}: {{intervalProgress}} / {{rollInterval}}</small></div>
            {{#if awaitingCompletionCheck}}<div class="sc-completion-check"><strong>{{localize "DOWNTIME_MANAGER.Project.CompletionCheck"}} · DC {{completionDC}}</strong>{{#if completionCheckFailed}}<small>{{localize "DOWNTIME_MANAGER.Project.CompletionRetryCost"}}: {{completionRetryCost}} {{localize "DOWNTIME_MANAGER.Station.Downtime"}}</small>{{/if}}</div><select data-completion-check-for="{{uuid}}">{{#each checks}}<option value="{{id}}">{{label}}</option>{{/each}}</select><button type="button" data-action="completionRoll" data-uuid="{{uuid}}" {{#unless canCompletionRoll}}disabled{{/unless}}><i class="fa-solid fa-flag-checkered"></i> {{localize "DOWNTIME_MANAGER.Project.RollCompletionCheck"}}</button>
            {{else}}{{#if pendingRoll}}<select data-check-for="{{uuid}}">{{#each checks}}<option value="{{id}}">{{label}}</option>{{/each}}</select><button type="button" data-action="roll" data-uuid="{{uuid}}" {{#unless canRoll}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i> {{localize "DOWNTIME_MANAGER.Actions.Roll"}}</button>
            {{else}}{{#if showCheckSelection}}<select data-check-for="{{uuid}}">{{#each checks}}<option value="{{id}}">{{label}}</option>{{/each}}</select>{{/if}}<input class="sc-downtime-input" type="number" data-downtime-for="{{uuid}}" value="{{investmentDefault}}" min="0.000001" max="{{maxInvestment}}" step="any"><button type="button" data-action="invest" data-uuid="{{uuid}}" {{#unless canInvest}}disabled{{/unless}}>{{localize "DOWNTIME_MANAGER.Actions.Invest"}}</button>{{/if}}{{/if}}<button type="button" data-action="cancel" data-uuid="{{uuid}}" class="sc-deactivate-project"><i class="fa-solid fa-ban"></i> {{localize "DOWNTIME_MANAGER.Actions.Cancel"}}</button>
          {{else}}{{#if paused}}<div class="sc-project-progress"><div><i class="fa-solid fa-pause"></i> {{progress}} / {{requiredProgress}} ({{percent}}%)</div><progress max="{{requiredProgress}}" value="{{progress}}"></progress><small class="notes">{{localize "DOWNTIME_MANAGER.Station.Interval"}}: {{intervalProgress}} / {{rollInterval}}</small></div>{{else}}{{#if completed}}<div class="sc-project-state">{{localize "DOWNTIME_MANAGER.Project.Completed"}}</div>{{else}}<div class="sc-project-state"></div>{{/if}}{{/if}}{{#unless paused}}<label class="sc-quantity-control"><span>{{localize "DOWNTIME_MANAGER.Project.Quantity"}}</span><input type="number" data-quantity-for="{{uuid}}" value="1" min="1" step="1"></label>{{/unless}}<button type="button" data-action="start" data-uuid="{{uuid}}" {{#if knownSpell}}disabled title="{{localize 'DOWNTIME_MANAGER.Errors.SpellAlreadyKnown'}}"{{/if}}>{{#if paused}}<i class="fa-solid fa-play"></i> {{localize "DOWNTIME_MANAGER.Actions.Resume"}}{{else}}{{localize "DOWNTIME_MANAGER.Actions.Start"}}{{/if}}</button>{{/if}}
          {{/if}}
        </div>

        {{#if lastResult}}<div class="sc-last-investment"><strong>{{localize "DOWNTIME_MANAGER.Station.LastInvestment"}}</strong><div class="sc-last-investment-summary"><span><strong>{{localize "DOWNTIME_MANAGER.Station.InvestedDowntime"}}:</strong> {{lastResult.downtime}}</span>{{#if lastResult.hasRoll}}<span><strong>{{localize "DOWNTIME_MANAGER.Station.RollResult"}}:</strong> {{#if lastResult.label}}{{lastResult.label}} · {{/if}}{{lastResult.rollTotal}} (d20: {{lastResult.natural}})</span>{{/if}}<span><strong>{{localize "DOWNTIME_MANAGER.Station.ProgressChange"}}:</strong> {{lastResult.progress}}</span>{{#if lastResult.actorValueEnabled}}{{#if lastResult.hasActorValueResult}}<span><strong>{{../actorValueLabel}}:</strong> {{lastResult.actorValueChange}} ({{lastResult.actorValueBefore}} → {{lastResult.actorValueAfter}})</span>{{/if}}{{/if}}{{#if lastResult.showRewardSummary}}<span><strong>{{localize "DOWNTIME_MANAGER.Station.Reward"}}:</strong> {{#if lastResult.rewards}}{{#each lastResult.rewards}}{{#unless @first}}, {{/unless}}{{name}} × {{quantity}}{{/each}}{{else}}{{localize "DOWNTIME_MANAGER.Common.None"}}{{/if}}</span>{{/if}}</div><details><summary>{{localize "DOWNTIME_MANAGER.Station.CalculationExplanation"}}</summary><code>{{lastResult.formula}}</code><dl class="sc-calculation-parts"><div><dt>{{localize "DOWNTIME_MANAGER.Calculation.Downtime"}}: {{lastResult.downtime}}</dt><dd>{{localize "DOWNTIME_MANAGER.Calculation.DowntimeHelp"}}</dd></div>{{#each lastResult.parts}}<div><dt>{{label}}: {{value}}</dt><dd>{{explanation}}</dd></div>{{/each}}</dl></details></div>{{/if}}
        </div>
      </details>
    {{else}}<p class="notes">{{localize "DOWNTIME_MANAGER.Station.NoProjects"}}</p>{{/each}}</div>
      <p class="notes sc-project-filter-empty" data-project-empty hidden>{{localize "DOWNTIME_MANAGER.Catalog.NoMatches"}}</p>
    </section>
  {{/if}}
</div>
