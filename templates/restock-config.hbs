<div class="tovf-restock-root">
  <header><div><h2>{{localize "TOVF.Interface.Restock.Title"}}</h2><small>{{actorName}}</small></div><label class="checkbox"><input type="checkbox" name="enabled" {{checked enabled}}> {{localize "TOVF.Interface.Restock.Automatic"}}</label></header>
  <div class="tovf-restock-rules">{{#each rules}}<article data-restock-rule data-rule-id="{{id}}"><header><label class="checkbox"><input type="checkbox" name="ruleEnabled" {{checked enabled}}> {{localize "TOVF.Interface.Restock.Rule"}}</label><button type="button" class="danger" data-action="removeRule" data-rule-id="{{id}}"><i class="fa-solid fa-trash"></i></button></header>
    <div class="tovf-restock-source"><label><span>RollTable</span><select name="tableId"><option value="">{{localize "TOVF.Interface.Restock.SelectTable"}}</option>{{#each tableOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label class="compact"><span>{{localize "TOVF.Interface.Restock.Rolls"}}</span><input type="number" name="rolls" value="{{rolls}}" min="1"></label><fieldset><legend>{{localize "TOVF.Interface.Restock.Quantity"}}</legend><input type="number" name="quantityMin" value="{{quantityMin}}" min="1"><span>–</span><input type="number" name="quantityMax" value="{{quantityMax}}" min="1"></fieldset></div>
    <div class="tovf-restock-timing"><fieldset><legend>{{localize "TOVF.Interface.Restock.Start"}}</legend><input type="datetime-local" name="startDate" value="{{startDate}}"></fieldset><fieldset><legend>{{localize "TOVF.Interface.Restock.Interval"}}</legend><input type="number" name="intervalValue" value="{{intervalValue}}" min="1"><select name="intervalUnit">{{selectOptions units selected=intervalUnit valueAttr="id" labelAttr="label"}}</select></fieldset><fieldset><legend>{{localize "TOVF.Interface.Restock.Discount"}}</legend><input type="number" name="discountValue" value="{{discountValue}}" min="0"><select name="discountUnit">{{selectOptions units selected=discountUnit valueAttr="id" labelAttr="label"}}</select><input type="number" name="discountPercent" value="{{discountPercent}}" min="0" max="100" title="%"><span>%</span></fieldset><fieldset><legend>{{localize "TOVF.Interface.Restock.Remove"}}</legend><input type="number" name="removeValue" value="{{removeValue}}" min="0"><select name="removeUnit">{{selectOptions units selected=removeUnit valueAttr="id" labelAttr="label"}}</select></fieldset></div><small>{{localize "TOVF.Interface.Restock.Next"}}: <span data-next-run>{{nextRun}}</span></small>
    {{#if hasDeliveries}}<details class="tovf-restock-history"><summary><strong>{{localize "TOVF.Interface.Restock.DeliveryHistory"}}</strong><span>{{deliveries.length}} {{localize "TOVF.Interface.Restock.Deliveries"}}</span></summary><div class="tovf-restock-history-table"><table><thead><tr><th>{{localize "TOVF.Interface.Restock.Item"}}</th><th>{{localize "TOVF.Interface.Restock.Amount"}}</th><th>{{localize "TOVF.Interface.Restock.Status"}}</th><th>{{localize "TOVF.Interface.Restock.DeliveredAt"}}</th><th>{{localize "TOVF.Interface.Restock.DiscountAt"}}</th><th>{{localize "TOVF.Interface.Restock.RemoveAt"}}</th></tr></thead>{{#each deliveries}}<tbody><tr class="tovf-restock-delivery-heading"><th colspan="6">{{localize "TOVF.Interface.Restock.Delivery"}} · {{deliveredAt}}</th></tr>{{#each items}}<tr><td><img src="{{img}}" alt=""><strong>{{name}}</strong></td><td>{{quantity}}</td><td><span class="tovf-restock-stock-status {{#if sold}}sold{{else}}available{{/if}}">{{#if sold}}{{localize "TOVF.Interface.Restock.Sold"}}{{else}}{{localize "TOVF.Interface.Restock.InStock"}}{{/if}}</span></td><td>{{../deliveredAt}}</td><td>{{discountLabel}}</td><td>{{removeLabel}}</td></tr>{{else}}<tr><td colspan="6"><em>{{localize "TOVF.Interface.Restock.NoNewItems"}}</em></td></tr>{{/each}}</tbody>{{/each}}</table></div></details>{{/if}}
  </article>{{else}}<p class="notes">{{localize "TOVF.Interface.Restock.Empty"}}</p>{{/each}}</div>
  <footer><button type="button" data-action="addRule"><i class="fa-solid fa-plus"></i> {{localize "TOVF.Interface.Restock.Add"}}</button><span></span><button type="button" data-action="run"><i class="fa-solid fa-truck-fast"></i> {{localize "TOVF.Interface.Restock.Run"}}</button><button type="button" data-action="save"><i class="fa-solid fa-floppy-disk"></i> {{localize "TOVF.Interface.Save_70b73b"}}</button></footer>
</div>
