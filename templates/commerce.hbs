<div class="tovf-commerce-body">
  <div class="tovf-commerce-character"><label>{{localize 'TOVF.Interface.Character_19365b'}}</label><select name="actorId">{{selectOptions characters selected=selectedActorId valueAttr="id" labelAttr="name"}}</select>{{#if selectedActor}}<div class="tovf-commerce-wallet" aria-label="{{localize 'TOVF.Interface.Wallet_eedb6c'}}">{{#each selectedActor.wallet}}<span title="{{id}}"><img src="{{img}}" alt="{{id}}"><strong>{{quantity}}</strong><small>{{id}}</small></span>{{/each}}</div>{{/if}}</div>
  {{#if merchantMode}}
    <section class="tovf-merchant-shell">
      {{#if selectedMerchant}}
        <aside class="tovf-merchant-sidebar">
          {{#if isGM}}<button type="button" class="tovf-merchant-portrait-button" data-action="chooseMerchantImage" title="{{localize 'TOVF.Interface.SelectActorImage_a05c40'}}"><img class="tovf-merchant-portrait" src="{{selectedMerchant.img}}" alt="{{selectedMerchant.name}}"><span><i class="fa-solid fa-image"></i> {{localize 'TOVF.Interface.ChangeImage_fc6f00'}}</span></button>{{else}}<img class="tovf-merchant-portrait" src="{{selectedMerchant.img}}" alt="{{selectedMerchant.name}}">{{/if}}
          {{#if isGM}}<div class="tovf-auction-house-heading"><h2>{{selectedMerchant.name}}</h2><button type="button" data-action="editMerchantDescription" title="{{localize 'TOVF.Interface.EditMerchant_64ce1a'}}" aria-label="{{localize 'TOVF.Interface.EditMerchant_64ce1a'}}"><i class="fa-solid fa-gear"></i></button></div>{{else}}<h2>{{selectedMerchant.name}}</h2>{{/if}}
          <div class="tovf-merchant-description">{{{selectedMerchant.description}}}</div>
          <nav><button type="button" class="{{#if buyPage}}active{{/if}}" data-action="changeShopPage" data-page="buy"><i class="fa-solid fa-basket-shopping"></i> {{localize 'TOVF.Interface.Buy_e86772'}}</button>{{#if canSell}}<button type="button" class="{{#if sellPage}}active{{/if}}" data-action="changeShopPage" data-page="sell"><i class="fa-solid fa-coins"></i> {{localize 'TOVF.Interface.Sell_b8efa6'}}</button>{{/if}}{{#if isGM}}<button type="button" class="{{#if managementPage}}active{{/if}}" data-action="changeShopPage" data-page="management"><i class="fa-solid fa-gear"></i> {{localize 'TOVF.Interface.Management_edad47'}}</button>{{/if}}</nav>
        </aside>
        <main class="tovf-merchant-content {{#if managementPage}}management{{/if}}">
          {{#if managementPage}}
            <form class="tovf-merchant-settings">
              <header><h3>{{localize 'TOVF.Interface.MerchantSettings_3936b1'}}</h3><button type="button" data-action="saveMerchantSettings"><i class="fa-solid fa-floppy-disk"></i> {{localize 'TOVF.Interface.Save_70b73b'}}</button></header>
              <div class="tovf-merchant-options"><label class="tovf-merchant-option-number"><span>{{localize 'TOVF.Interface.PurchaseMultiplier_834e25'}}</span><input name="buyModifier" type="number" value="{{config.buyModifier}}" min="0" step="0.05"></label><label class="tovf-merchant-option-number"><span>{{localize 'TOVF.Interface.SaleMultiplier_0ec1c3'}}</span><input name="sellModifier" type="number" value="{{config.sellModifier}}" min="0" step="0.05"></label><label class="tovf-merchant-option-number"><span><input name="requireInteractionRange" type="checkbox" {{checked config.requireInteractionRange}}> {{localize 'TOVF.Interface.RangeRequired_ee089a'}}</span><input name="interactionRange" type="number" value="{{config.interactionRange}}" min="1" step="1" title="{{localize 'TOVF.Interface.RangeInGridSpaces_cb4cca'}}"></label><label><input name="infiniteStock" type="checkbox" {{checked config.infiniteStock}}> {{localize 'TOVF.Interface.InfiniteStock_d352a7'}}</label><label><input name="infiniteCurrency" type="checkbox" {{checked config.infiniteCurrency}}> {{localize 'TOVF.Interface.InfiniteCurrency_89c4a1'}}</label><label><input name="purchaseOnly" type="checkbox" {{checked config.purchaseOnly}}> {{localize 'TOVF.Interface.MerchantOnlySells_02bb3c'}}</label><label><input name="keepSoldItems" type="checkbox" {{checked config.keepSoldItems}}> {{localize 'TOVF.Interface.AddPurchasedItemsToInventory_8b7778'}}</label><label><input name="hideNewItems" type="checkbox" {{checked config.hideNewItems}}> {{localize 'TOVF.Interface.InitiallyHidePurchasedItems_cd1869'}}</label><label><input name="displayQuantity" type="checkbox" {{checked config.displayQuantity}}> {{localize 'TOVF.Interface.ShowQuantities_5f1ad4'}}</label><label><input name="showZeroQuantity" type="checkbox" {{checked config.showZeroQuantity}}> {{localize 'TOVF.Interface.ShowItemsWithZeroStock_60bfb7'}}</label></div>
              <div class="tovf-merchant-access"><span><strong>{{localize 'TOVF.Interface.Access_9da2ff'}}</strong><small>{{#if config.allowedActorIds.length}}{{config.allowedActorIds.length}} {{localize 'TOVF.Interface.CharactersAllowed_31d644'}}{{else}}{{localize 'TOVF.Interface.AllCharacters_deea0d'}}{{/if}}</small></span><div><button type="button" data-action="selectMerchantCharacters"><i class="fa-solid fa-users-gear"></i> {{localize 'TOVF.Interface.Characters_346a51'}}</button><button type="button" data-action="configureMerchantRequirements"><i class="fa-solid fa-list-check"></i> {{localize 'TOVF.Interface.RequirementsMessage_fb0d6c'}}</button></div></div>
            </form>
            <section class="tovf-merchant-stock-tools"><header><h3>{{localize 'TOVF.Interface.InventoryManagement_ca8253'}}</h3><span><button type="button" data-action="clearMerchantItems"><i class="fa-solid fa-trash"></i> {{localize 'TOVF.Interface.RemoveAllItems_c084bf'}}</button></span></header><div class="tovf-rolltable-stock-controls"><label class="tovf-rolltable-select">Rolltable<select name="rollTableId"><option value="">{{localize 'TOVF.Interface.SelectRolltable_cf67cf'}}</option>{{selectOptions rollTables valueAttr="id" labelAttr="name"}}</select></label><label>{{localize 'TOVF.Interface.Rolls_3a7b36'}}<input name="rollCount" type="number" value="1" min="1" step="1"></label><fieldset><legend>{{localize 'TOVF.Interface.QuantityPerItem_6d42fb'}}</legend><label>{{localize 'TOVF.Interface.From_a4b078'}}<input name="rollQuantityMin" type="number" value="1" min="1" step="1"></label><label>{{localize 'TOVF.Interface.To_0afaa0'}}<input name="rollQuantityMax" type="number" value="1" min="1" step="1"></label></fieldset><button type="button" data-action="populateFromTable"><i class="fa-solid fa-dice"></i> {{localize 'TOVF.Interface.AddFromRolltable_b522fa'}}</button></div></section>
          {{else}}
            <header class="tovf-shop-heading"><div><h2>{{#if buyPage}}{{localize 'TOVF.Interface.Stock_67ba6e'}}{{else}}{{localize 'TOVF.Interface.SellToTheMerchant_243086'}}{{/if}}</h2><small>{{selectedMerchant.itemCount}} {{localize 'TOVF.Interface.Items_308396'}}</small></div></header>
          {{/if}}
          <div class="tovf-shop-filters"><input name="search" type="search" value="{{search}}" placeholder="{{localize 'TOVF.Interface.SearchItems_a226fa'}}"><select name="category"><option value="">{{localize 'TOVF.Interface.AllTypes_172a95'}}</option>{{selectOptions categories selected=selectedCategory valueAttr="id" labelAttr="label"}}</select><select name="sort"><option value="type" {{#if (eq selectedSort "type")}}selected{{/if}}>{{localize 'TOVF.Interface.SortType_6950ce'}}</option><option value="name" {{#if (eq selectedSort "name")}}selected{{/if}}>{{localize 'TOVF.Interface.SortName_aea9b1'}}</option><option value="price" {{#if (eq selectedSort "price")}}selected{{/if}}>{{localize 'TOVF.Interface.SortPrice_dab086'}}</option></select></div>
          <div class="tovf-shop-list">{{#each selectedMerchant.inventoryGroups}}<section class="tovf-shop-group"><header><h3>{{label}}</h3><span>{{localize 'TOVF.Interface.Price_027292'}}</span></header>{{#each items}}<article class="{{#if hidden}}hidden-item{{/if}} {{#if discounted}}special-offer{{/if}}"><button type="button" class="tovf-shop-item-open" data-action="openMerchantItem" data-actor-id="{{actorId}}" data-item-id="{{id}}" data-offer-id="{{offerId}}"><img src="{{img}}"><span><b>{{name}}</b>{{#if discounted}}<em class="tovf-offer-label">{{localize 'TOVF.Interface.Sale_e9d17c'}}{{discountPercent}}%</em>{{/if}}{{#if detailLabel}}<small>{{detailLabel}}</small>{{/if}}{{#if ../../buyPage}}{{#if purchaseMessage}}<small>{{purchaseMessage}}</small>{{/if}}{{/if}}</span></button><div class="tovf-shop-price-stack">{{#if discounted}}<s class="tovf-shop-original-price" aria-label="Originalpreis {{originalPrice}}">{{#each originalPriceCoins}}<span><b>{{quantity}}</b><img src="{{img}}" alt="{{id}}"></span>{{/each}}</s>{{/if}}<strong class="tovf-shop-price" aria-label="{{price}}">{{#each priceCoins}}<span title="{{id}}"><b>{{quantity}}</b><img src="{{img}}" alt="{{id}}"></span>{{/each}}</strong></div><div class="tovf-shop-actions">{{#if ../../managementPage}}<button type="button" data-action="configureOfferAccess" data-item-id="{{id}}" data-offer-id="{{offerId}}" title="{{localize 'TOVF.Interface.PurchaseRulesAndRelease_33cbb0'}}"><i class="fa-solid fa-lock"></i></button><button type="button" data-action="setItemDiscount" data-item-id="{{id}}" data-offer-id="{{offerId}}" data-discount="{{discountPercent}}" title="{{localize 'TOVF.Interface.SetDiscount_352e23'}}"><i class="fa-solid fa-tags"></i></button><button type="button" data-action="toggleMerchantItem" data-item-id="{{id}}" data-offer-id="{{offerId}}" data-hidden="{{hidden}}" title="{{localize 'TOVF.Interface.Visibility_0218eb'}}"><i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i></button><button type="button" data-action="deleteMerchantItem" data-item-id="{{id}}" data-offer-id="{{offerId}}" title="{{localize 'TOVF.Interface.Remove_f78b63'}}"><i class="fa-solid fa-trash"></i></button>{{else if ../../buyPage}}<button type="button" data-action="buy" data-item-id="{{id}}" data-offer-id="{{offerId}}" {{#if purchaseBlocked}}disabled title="{{purchaseMessage}}"{{/if}}><i class="fa-solid fa-cart-shopping"></i> {{localize 'TOVF.Interface.Buy_e86772'}}</button>{{else}}<button type="button" data-action="sell" data-item-id="{{id}}"><i class="fa-solid fa-coins"></i> {{localize 'TOVF.Interface.Sell_b8efa6'}}</button>{{/if}}</div></article>{{/each}}</section>{{/each}}{{#unless selectedMerchant.hasInventory}}<p class="tovf-shop-empty">{{localize 'TOVF.Interface.NoMatchingItems_6c1c83'}}</p>{{/unless}}</div>
        </main>
      {{else}}<div class="tovf-commerce-empty"><p>{{localize 'TOVF.Interface.NoMerchantConfiguredYet_1b144a'}}</p>{{#if isGM}}<button type="button" data-action="configureMerchant">{{localize 'TOVF.Interface.ConfigureMerchant_f3b57a'}}</button>{{/if}}</div>{{/if}}
    </section>
  {{/if}}
  {{#if auctionMode}}<section class="tovf-auction-shell">{{#if auctionHouse}}<aside class="tovf-merchant-sidebar">{{#if isGM}}<button type="button" class="tovf-merchant-portrait-button" data-action="chooseMerchantImage" title="{{localize 'TOVF.Interface.SelectActorImage_a05c40'}}"><img class="tovf-merchant-portrait" src="{{auctionHouse.img}}" alt="{{auctionHouse.name}}"><span><i class="fa-solid fa-image"></i> {{localize 'TOVF.Interface.ChangeImage_fc6f00'}}</span></button>{{else}}<img class="tovf-merchant-portrait" src="{{auctionHouse.img}}" alt="{{auctionHouse.name}}">{{/if}}<h2>{{auctionHouse.name}}</h2><div class="tovf-merchant-description">{{{auctionHouse.description}}}</div><button type="button" data-action="createAuction"><i class="fa-solid fa-plus"></i> {{localize 'TOVF.Interface.CreateAuction_1ed1b4'}}</button></aside>{{/if}}<main class="tovf-auction-content"><header><div><h2>{{localize 'TOVF.Interface.ActiveAuctions_5604e3'}}</h2><small>{{auctions.length}} {{localize 'TOVF.Interface.Offers_53bcfa'}}</small></div><button type="button" data-action="createAuction"><i class="fa-solid fa-plus"></i> {{localize 'TOVF.Interface.CreateAuction_1ed1b4'}}</button></header><div class="tovf-shop-filters"><input name="search" type="search" value="{{search}}" placeholder="{{localize 'TOVF.Interface.SearchAuctions_b8c326'}}"><select name="category"><option value="">{{localize 'TOVF.Interface.AllTypes_172a95'}}</option>{{selectOptions auctionCategories selected=selectedCategory valueAttr="id" labelAttr="label"}}</select><select name="sort"><option value="type" {{#if (eq selectedSort "type")}}selected{{/if}}>{{localize 'TOVF.Interface.SortType_6950ce'}}</option><option value="name" {{#if (eq selectedSort "name")}}selected{{/if}}>{{localize 'TOVF.Interface.SortName_aea9b1'}}</option><option value="price" {{#if (eq selectedSort "price")}}selected{{/if}}>{{localize 'TOVF.Interface.SortPrice_dab086'}}</option></select></div><div class="tovf-auction-list"><header><span>{{localize 'TOVF.Interface.Item_fd5bce'}}</span><span>{{localize 'TOVF.Interface.Seller_2f139d'}}</span><span>{{localize 'TOVF.Interface.Bid_5cca6e'}}</span><span>{{localize 'TOVF.Interface.TimeRemaining_da0632'}}</span><span></span></header>{{#each auctions}}<article class="{{#if buyoutCopper}}has-buyout{{/if}}"><button type="button" class="tovf-shop-item-open" data-action="openAuctionItem" data-auction-id="{{id}}"><img src="{{itemImg}}"><span><b>{{quantity}}× {{itemName}}</b><small>{{categoryLabel}}</small></span></button><span class="tovf-auction-seller">{{seller}}</span><div class="tovf-auction-prices"><strong class="tovf-shop-price">{{#each currentCoins}}<span><b>{{quantity}}</b><img src="{{img}}" alt="{{id}}"></span>{{/each}}</strong>{{#if buyoutCopper}}<small>{{localize 'TOVF.Interface.Buyout_19b39b'}} {{#each buyoutCoins}}<b>{{quantity}}</b><img src="{{img}}" alt="{{id}}">{{/each}}</small>{{/if}}</div><strong class="tovf-auction-time">{{remaining}}</strong><div class="tovf-shop-actions"><button type="button" data-action="bid" data-auction-id="{{id}}" data-minimum="{{#if highestBid}}{{highestBid}}{{else}}{{startCopper}}{{/if}}">{{localize 'TOVF.Interface.PlaceBid_7f2c2f'}}</button>{{#if buyoutCopper}}<button type="button" data-action="buyout" data-auction-id="{{id}}"><i class="fa-solid fa-bolt"></i> {{localize 'TOVF.Interface.Buy_e86772'}}</button>{{/if}}</div></article>{{else}}<p class="tovf-shop-empty">{{localize 'TOVF.Interface.NoActiveAuctions_d77c77'}}</p>{{/each}}</div></main></section>{{/if}}
  {{#if tradeMode}}<section class="tovf-commerce-panel"><header><h3>{{localize 'TOVF.Interface.TradeOffers_1e752a'}}</h3><button type="button" data-action="createTrade">{{localize 'TOVF.Interface.CreateOffer_a8a2e6'}}</button></header><div class="tovf-commerce-list">{{#each trades}}<article><span><b>{{fromName}} → {{toName}}</b><small>{{localize 'TOVF.Interface.Offer_264272'}} {{fromMoney}} {{localize 'TOVF.Interface.Request_e458a7'}} {{toMoney}}</small></span>{{#if canAccept}}<button type="button" data-action="acceptTrade" data-trade-id="{{id}}">{{localize 'TOVF.Interface.Accept_c1c1e0'}}</button>{{/if}}{{#if canCancel}}<button type="button" data-action="cancelTrade" data-trade-id="{{id}}">{{localize 'TOVF.Interface.Decline_6a0ac7'}}</button>{{/if}}</article>{{else}}<p>{{localize 'TOVF.Interface.NoOpenTradeOffers_09b1df'}}</p>{{/each}}</div></section>{{/if}}
</div>
