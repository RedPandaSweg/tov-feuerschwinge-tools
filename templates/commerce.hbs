<div class="tovf-commerce-body">
  <div class="tovf-commerce-character"><label>Charakter</label><select name="actorId">{{selectOptions characters selected=selectedActorId valueAttr="id" labelAttr="name"}}</select>{{#if selectedActor}}<div class="tovf-commerce-wallet" aria-label="Geldbeutel">{{#each selectedActor.wallet}}<span title="{{id}}"><img src="{{img}}" alt="{{id}}"><strong>{{quantity}}</strong><small>{{id}}</small></span>{{/each}}</div>{{/if}}</div>
  {{#if merchantMode}}
    <section class="tovf-merchant-shell">
      {{#if selectedMerchant}}
        <aside class="tovf-merchant-sidebar">
          {{#if isGM}}<button type="button" class="tovf-merchant-portrait-button" data-action="chooseMerchantImage" title="Actorbild auswählen"><img class="tovf-merchant-portrait" src="{{selectedMerchant.img}}" alt="{{selectedMerchant.name}}"><span><i class="fa-solid fa-image"></i> Bild ändern</span></button>{{else}}<img class="tovf-merchant-portrait" src="{{selectedMerchant.img}}" alt="{{selectedMerchant.name}}">{{/if}}
          {{#if isGM}}<div class="tovf-auction-house-heading"><h2>{{selectedMerchant.name}}</h2><button type="button" data-action="editMerchantDescription" title="Händler bearbeiten" aria-label="Händler bearbeiten"><i class="fa-solid fa-gear"></i></button></div>{{else}}<h2>{{selectedMerchant.name}}</h2>{{/if}}
          <div class="tovf-merchant-description">{{{selectedMerchant.description}}}</div>
          <nav><button type="button" class="{{#if buyPage}}active{{/if}}" data-action="changeShopPage" data-page="buy"><i class="fa-solid fa-basket-shopping"></i> Kaufen</button>{{#if canSell}}<button type="button" class="{{#if sellPage}}active{{/if}}" data-action="changeShopPage" data-page="sell"><i class="fa-solid fa-coins"></i> Verkaufen</button>{{/if}}{{#if isGM}}<button type="button" class="{{#if managementPage}}active{{/if}}" data-action="changeShopPage" data-page="management"><i class="fa-solid fa-gear"></i> Verwaltung</button>{{/if}}</nav>
        </aside>
        <main class="tovf-merchant-content {{#if managementPage}}management{{/if}}">
          {{#if managementPage}}
            <form class="tovf-merchant-settings">
              <header><h3>Händlereinstellungen</h3><button type="button" data-action="saveMerchantSettings"><i class="fa-solid fa-floppy-disk"></i> Speichern</button></header>
              <div class="tovf-merchant-options"><label class="tovf-merchant-option-number"><span>Kaufmultiplikator</span><input name="buyModifier" type="number" value="{{config.buyModifier}}" min="0" step="0.05"></label><label class="tovf-merchant-option-number"><span>Verkaufsmultiplikator</span><input name="sellModifier" type="number" value="{{config.sellModifier}}" min="0" step="0.05"></label><label class="tovf-merchant-option-number"><span><input name="requireInteractionRange" type="checkbox" {{checked config.requireInteractionRange}}> Reichweite erforderlich</span><input name="interactionRange" type="number" value="{{config.interactionRange}}" min="1" step="1" title="Reichweite in Feldern"></label><label><input name="infiniteStock" type="checkbox" {{checked config.infiniteStock}}> Unendlicher Bestand</label><label><input name="infiniteCurrency" type="checkbox" {{checked config.infiniteCurrency}}> Unendliche Währung</label><label><input name="purchaseOnly" type="checkbox" {{checked config.purchaseOnly}}> Händler verkauft nur</label><label><input name="keepSoldItems" type="checkbox" {{checked config.keepSoldItems}}> Verkaufte Gegenstände ins Inventar übernehmen</label><label><input name="hideNewItems" type="checkbox" {{checked config.hideNewItems}}> Übernommene Gegenstände zunächst ausblenden</label><label><input name="displayQuantity" type="checkbox" {{checked config.displayQuantity}}> Mengen anzeigen</label><label><input name="showZeroQuantity" type="checkbox" {{checked config.showZeroQuantity}}> Gegenstände mit Bestand 0 anzeigen</label></div>
              <div class="tovf-merchant-access"><span><strong>Zugriff</strong><small>{{#if config.allowedActorIds.length}}{{config.allowedActorIds.length}} Charaktere freigeschaltet{{else}}Alle Charaktere{{/if}}</small></span><div><button type="button" data-action="selectMerchantCharacters"><i class="fa-solid fa-users-gear"></i> Charaktere</button><button type="button" data-action="configureMerchantRequirements"><i class="fa-solid fa-list-check"></i> Voraussetzungen &amp; Nachricht</button></div></div>
            </form>
            <section class="tovf-merchant-stock-tools"><header><h3>Inventarverwaltung</h3><span><button type="button" data-action="clearMerchantItems"><i class="fa-solid fa-trash"></i> Alle Gegenstände entfernen</button></span></header><div class="tovf-rolltable-stock-controls"><label class="tovf-rolltable-select">Rolltable<select name="rollTableId"><option value="">Rolltable auswählen</option>{{selectOptions rollTables valueAttr="id" labelAttr="name"}}</select></label><label>Würfe<input name="rollCount" type="number" value="1" min="1" step="1"></label><fieldset><legend>Menge pro Item</legend><label>Von<input name="rollQuantityMin" type="number" value="1" min="1" step="1"></label><label>Bis<input name="rollQuantityMax" type="number" value="1" min="1" step="1"></label></fieldset><button type="button" data-action="populateFromTable"><i class="fa-solid fa-dice"></i> Aus Rolltable hinzufügen</button></div></section>
          {{else}}
            <header class="tovf-shop-heading"><div><h2>{{#if buyPage}}Warenangebot{{else}}An den Händler verkaufen{{/if}}</h2><small>{{selectedMerchant.itemCount}} Gegenstände</small></div></header>
          {{/if}}
          <div class="tovf-shop-filters"><input name="search" type="search" value="{{search}}" placeholder="Gegenstände suchen …"><select name="category"><option value="">Alle Typen</option>{{selectOptions categories selected=selectedCategory valueAttr="id" labelAttr="label"}}</select><select name="sort"><option value="type" {{#if (eq selectedSort "type")}}selected{{/if}}>Sortieren: Typ</option><option value="name" {{#if (eq selectedSort "name")}}selected{{/if}}>Sortieren: Name</option><option value="price" {{#if (eq selectedSort "price")}}selected{{/if}}>Sortieren: Preis</option></select></div>
          <div class="tovf-shop-list">{{#each selectedMerchant.inventoryGroups}}<section class="tovf-shop-group"><header><h3>{{label}}</h3><span>Preis</span></header>{{#each items}}<article class="{{#if hidden}}hidden-item{{/if}} {{#if discounted}}special-offer{{/if}}"><button type="button" class="tovf-shop-item-open" data-action="openMerchantItem" data-actor-id="{{actorId}}" data-item-id="{{id}}"><img src="{{img}}"><span><b>{{name}}</b>{{#if discounted}}<em class="tovf-offer-label">Angebot −{{discountPercent}}%</em>{{/if}}{{#if detailLabel}}<small>{{detailLabel}}</small>{{/if}}</span></button><div class="tovf-shop-price-stack">{{#if discounted}}<s class="tovf-shop-original-price" aria-label="Originalpreis {{originalPrice}}">{{#each originalPriceCoins}}<span><b>{{quantity}}</b><img src="{{img}}" alt="{{id}}"></span>{{/each}}</s>{{/if}}<strong class="tovf-shop-price" aria-label="{{price}}">{{#each priceCoins}}<span title="{{id}}"><b>{{quantity}}</b><img src="{{img}}" alt="{{id}}"></span>{{/each}}</strong></div><div class="tovf-shop-actions">{{#if ../../managementPage}}<button type="button" data-action="setItemDiscount" data-item-id="{{id}}" data-discount="{{discountPercent}}" title="Rabatt festlegen"><i class="fa-solid fa-tags"></i></button><button type="button" data-action="toggleMerchantItem" data-item-id="{{id}}" data-hidden="{{hidden}}" title="Sichtbarkeit"><i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i></button><button type="button" data-action="deleteMerchantItem" data-item-id="{{id}}" title="Entfernen"><i class="fa-solid fa-trash"></i></button>{{else if ../../buyPage}}<button type="button" data-action="buy" data-item-id="{{id}}"><i class="fa-solid fa-cart-shopping"></i> Kaufen</button>{{else}}<button type="button" data-action="sell" data-item-id="{{id}}"><i class="fa-solid fa-coins"></i> Verkaufen</button>{{/if}}</div></article>{{/each}}</section>{{/each}}{{#unless selectedMerchant.hasInventory}}<p class="tovf-shop-empty">Keine passenden Gegenstände.</p>{{/unless}}</div>
        </main>
      {{else}}<div class="tovf-commerce-empty"><p>Noch kein Händler eingerichtet.</p>{{#if isGM}}<button type="button" data-action="configureMerchant">Händler einrichten</button>{{/if}}</div>{{/if}}
    </section>
  {{/if}}
  {{#if auctionMode}}<section class="tovf-auction-shell">{{#if auctionHouse}}<aside class="tovf-merchant-sidebar">{{#if isGM}}<button type="button" class="tovf-merchant-portrait-button" data-action="chooseMerchantImage" title="Actorbild auswählen"><img class="tovf-merchant-portrait" src="{{auctionHouse.img}}" alt="{{auctionHouse.name}}"><span><i class="fa-solid fa-image"></i> Bild ändern</span></button>{{else}}<img class="tovf-merchant-portrait" src="{{auctionHouse.img}}" alt="{{auctionHouse.name}}">{{/if}}<h2>{{auctionHouse.name}}</h2><div class="tovf-merchant-description">{{{auctionHouse.description}}}</div><button type="button" data-action="createAuction"><i class="fa-solid fa-plus"></i> Auktion erstellen</button></aside>{{/if}}<main class="tovf-auction-content"><header><div><h2>Aktive Auktionen</h2><small>{{auctions.length}} Angebote</small></div><button type="button" data-action="createAuction"><i class="fa-solid fa-plus"></i> Auktion erstellen</button></header><div class="tovf-shop-filters"><input name="search" type="search" value="{{search}}" placeholder="Auktionen durchsuchen …"><select name="category"><option value="">Alle Typen</option>{{selectOptions auctionCategories selected=selectedCategory valueAttr="id" labelAttr="label"}}</select><select name="sort"><option value="type" {{#if (eq selectedSort "type")}}selected{{/if}}>Sortieren: Typ</option><option value="name" {{#if (eq selectedSort "name")}}selected{{/if}}>Sortieren: Name</option><option value="price" {{#if (eq selectedSort "price")}}selected{{/if}}>Sortieren: Preis</option></select></div><div class="tovf-auction-list"><header><span>Gegenstand</span><span>Verkäufer</span><span>Gebot</span><span>Restzeit</span><span></span></header>{{#each auctions}}<article class="{{#if buyoutCopper}}has-buyout{{/if}}"><button type="button" class="tovf-shop-item-open" data-action="openAuctionItem" data-auction-id="{{id}}"><img src="{{itemImg}}"><span><b>{{quantity}}× {{itemName}}</b><small>{{categoryLabel}}</small></span></button><span class="tovf-auction-seller">{{seller}}</span><div class="tovf-auction-prices"><strong class="tovf-shop-price">{{#each currentCoins}}<span><b>{{quantity}}</b><img src="{{img}}" alt="{{id}}"></span>{{/each}}</strong>{{#if buyoutCopper}}<small>Sofortkauf {{#each buyoutCoins}}<b>{{quantity}}</b><img src="{{img}}" alt="{{id}}">{{/each}}</small>{{/if}}</div><strong class="tovf-auction-time">{{remaining}}</strong><div class="tovf-shop-actions"><button type="button" data-action="bid" data-auction-id="{{id}}" data-minimum="{{#if highestBid}}{{highestBid}}{{else}}{{startCopper}}{{/if}}">Bieten</button>{{#if buyoutCopper}}<button type="button" data-action="buyout" data-auction-id="{{id}}"><i class="fa-solid fa-bolt"></i> Kaufen</button>{{/if}}</div></article>{{else}}<p class="tovf-shop-empty">Keine aktiven Auktionen.</p>{{/each}}</div></main></section>{{/if}}
  {{#if tradeMode}}<section class="tovf-commerce-panel"><header><h3>Handelsangebote</h3><button type="button" data-action="createTrade">Angebot erstellen</button></header><div class="tovf-commerce-list">{{#each trades}}<article><span><b>{{fromName}} → {{toName}}</b><small>Angebot: {{fromMoney}} · Forderung: {{toMoney}}</small></span>{{#if canAccept}}<button type="button" data-action="acceptTrade" data-trade-id="{{id}}">Annehmen</button>{{/if}}{{#if canCancel}}<button type="button" data-action="cancelTrade" data-trade-id="{{id}}">Ablehnen</button>{{/if}}</article>{{else}}<p>Keine offenen Handelsangebote.</p>{{/each}}</div></section>{{/if}}
</div>
