<div class="tovf-library-root">
  <nav class="tovf-library-categories">
    {{#each primaryCategories}}
    <button type="button" class="{{#if active}}active{{/if}}" data-action="selectCategory" data-category="{{id}}">
      <i class="{{icon}}" inert></i>
      <span>{{localize label}}</span>
      <small>{{count}}</small>
    </button>
    {{/each}}
    <details class="tovf-library-more {{#if moreCategoryActive}}active{{/if}}">
      <summary>
        <i class="fa-solid fa-ellipsis" inert></i>
        <span>{{#if activeMoreCategory}}{{localize activeMoreCategory.label}}{{else}}{{localize "TOVF.Library.More"}}{{/if}}</span>
        {{#if activeMoreCategory}}<small>{{activeMoreCategory.count}}</small>{{/if}}
      </summary>
      <div>
        {{#each moreCategories}}
        <button type="button" class="{{#if active}}active{{/if}}" data-action="selectCategory" data-category="{{id}}">
          <i class="{{icon}}" inert></i><span>{{localize label}}</span><small>{{count}}</small>
        </button>
        {{/each}}
      </div>
    </details>
  </nav>

  <section class="tovf-library-content">
    <header>
      <input type="search" value="{{query}}" placeholder="{{localize 'TOVF.Library.Search'}}" data-library-search>
      <details class="tovf-library-source-filter">
        <summary>{{sourceSelectionLabel}}</summary>
        <div>
          <label><input type="checkbox" value="" data-library-source {{checked allSourcesSelected}}>
            {{localize "TOVF.Library.AllSources"}}</label>
          {{#each sources}}
          <label><input type="checkbox" value="{{value}}" data-library-source {{checked selected}}>
            {{label}}</label>
          {{/each}}
        </div>
      </details>
      <div class="tovf-library-layout" role="group" aria-label="Layout">
        {{#if isGM}}<button type="button" class="{{#if tableBuilder}}active{{/if}}" data-action="toggleTableBuilder"
                title="Rolltable aus Bibliotheks-Items erstellen"><i class="fa-solid fa-dice-d20" inert></i></button>{{/if}}
        <button type="button" class="{{#if listLayout}}active{{/if}}" data-action="setLayout" data-layout="list"
                title="List View"><i class="fa-solid fa-list" inert></i></button>
        <button type="button" class="{{#if gridLayout}}active{{/if}}" data-action="setLayout" data-layout="grid"
                title="Grid View"><i class="fa-solid fa-grid-2" inert></i></button>
      </div>
    </header>
    {{#unless hasLibraryIndex}}<p class="tovf-library-index-notice">{{#if isGM}}{{localize "TOVF.Library.Index.GmMissing"}}{{else}}{{localize "TOVF.Library.Index.PlayerMissing"}}{{/if}}</p>{{/unless}}
    {{#if tableBuilder}}
    <div class="tovf-library-table-builder">
      <strong><i class="fa-solid fa-dice-d20"></i> Rolltable-Ersteller</strong>
      <span><b data-table-selection-count>{{tableSelectionCount}}</b> Einträge ausgewählt</span>
      <button type="button" data-table-action="select-visible">Alle sichtbaren Einträge auswählen</button>
      <button type="button" data-table-action="clear">Auswahl leeren</button>
      <button type="button" data-table-action="create" {{#unless tableSelectionCount}}disabled{{/unless}}>Rolltable erstellen</button>
    </div>
    {{/if}}
    <div class="tovf-library-filter-area">
    {{#if challengeRatings.length}}
    <nav class="tovf-library-filters" aria-label="{{localize 'TOVF.Library.ChallengeRating'}}">
      <strong class="filter-label">{{localize "TOVF.Library.ChallengeRating"}}</strong>
      <select data-library-filter="challengeRating">
        <option value="">{{localize "TOVF.Library.AllChallengeRatings"}}</option>
        {{selectOptions challengeRatings selected=selectedChallengeRating valueAttr="value" labelAttr="label"}}
      </select>
    </nav>
    {{/if}}
    <nav class="tovf-library-filters" aria-label="Subcategories">
      <strong class="filter-label">{{subcategoryLabel}}</strong>
      {{#if compactSubcategories}}
      <select data-library-filter="subcategory">
        <option value="">All</option>
        {{selectOptions subcategories selected=selectedSubcategory valueAttr="value" labelAttr="displayLabel"}}
      </select>
      {{else}}
      <button type="button" class="{{#unless selectedSubcategory}}active{{/unless}}"
              data-action="selectSubcategory" data-subcategory="">All</button>
      {{#each subcategories}}
      <button type="button" class="{{#if active}}active{{/if}}"
              data-action="selectSubcategory" data-subcategory="{{value}}">{{label}} <small>{{count}}</small></button>
      {{/each}}
      {{/if}}
    </nav>
    {{#if details.length}}
    <nav class="tovf-library-filters secondary" aria-label="Types">
      <strong class="filter-label">{{detailLabel}}</strong>
      {{#if compactDetails}}
      <select data-library-filter="detail">
        <option value="">All</option>
        {{selectOptions details selected=selectedDetail valueAttr="value" labelAttr="displayLabel"}}
      </select>
      {{else}}
      <button type="button" class="{{#unless selectedDetail}}active{{/unless}}"
              data-action="selectDetail" data-detail="">All</button>
      {{#each details}}
      <button type="button" class="{{#if active}}active{{/if}}"
              data-action="selectDetail" data-detail="{{value}}">{{label}} <small>{{count}}</small></button>
      {{/each}}
      {{/if}}
    </nav>
    {{/if}}
    {{#if extras.length}}
    <nav class="tovf-library-filters secondary" aria-label="School of Magic">
      <strong class="filter-label">{{extraLabel}}</strong>
      {{#if compactExtras}}
      <select data-library-filter="extra">
        <option value="">All</option>
        {{selectOptions extras selected=selectedExtra valueAttr="value" labelAttr="displayLabel"}}
      </select>
      {{else}}
      <button type="button" class="{{#unless selectedExtra}}active{{/unless}}"
              data-action="selectExtra" data-extra="">All</button>
      {{#each extras}}
      <button type="button" class="{{#if active}}active{{/if}}"
              data-action="selectExtra" data-extra="{{value}}">{{label}} <small>{{count}}</small></button>
      {{/each}}
      {{/if}}
    </nav>
    {{/if}}
    {{#if showMagicItemFilters}}
    <nav class="tovf-library-filters secondary" aria-label="{{localize 'TOVF.Library.Attunement.Label'}}">
      <strong class="filter-label">{{localize "TOVF.Library.Attunement.Label"}}</strong>
      <select data-library-filter="magicAttunement">
        <option value="">{{localize "TOVF.Library.Attunement.All"}}</option>
        {{selectOptions magicAttunementOptions selected=selectedMagicAttunement valueAttr="value" labelAttr="label"}}
      </select>
      {{#if magicCategories}}<strong class="filter-label">{{localize "TOVF.Library.MagicItemFilters.Category"}}</strong><select data-library-filter="magicCategory"><option value="">{{localize "TOVF.Library.All"}}</option>{{#each magicCategories}}<option value="{{value}}" {{#if (eq value ../selectedMagicCategory)}}selected{{/if}}>{{label}} ({{count}})</option>{{/each}}</select>{{/if}}
      {{#if magicTypes}}<strong class="filter-label">{{localize "TOVF.Library.MagicItemFilters.Type"}}</strong><select data-library-filter="magicType"><option value="">{{localize "TOVF.Library.All"}}</option>{{#each magicTypes}}<option value="{{value}}" {{#if (eq value ../selectedMagicType)}}selected{{/if}}>{{label}} ({{count}})</option>{{/each}}</select>{{/if}}
      {{#if magicBases}}<strong class="filter-label">{{localize "TOVF.Library.MagicItemFilters.Base"}}</strong><select data-library-filter="magicBase"><option value="">{{localize "TOVF.Library.All"}}</option>{{#each magicBases}}<option value="{{value}}" {{#if (eq value ../selectedMagicBase)}}selected{{/if}}>{{label}} ({{count}})</option>{{/each}}</select>{{/if}}
      <strong class="filter-label">{{localize "TOVF.Library.Sort.Label"}}</strong>
      <select data-library-filter="magicItemSort">
        <option value="name" {{#if (eq selectedMagicItemSort "name")}}selected{{/if}}>{{localize "TOVF.Library.Sort.Name"}}</option>
        <option value="price" {{#if (eq selectedMagicItemSort "price")}}selected{{/if}}>{{localize "TOVF.Library.Sort.Price"}}</option>
      </select>
    </nav>
    {{/if}}
    {{#if showMonsterFilters}}
    <details class="tovf-library-spell-filters" open>
      <summary><span><i class="fa-solid fa-filter" inert></i> {{localize "TOVF.Library.MonsterFilters.Title"}}</span>{{#if monsterFilterCount}}<small>{{localize "TOVF.Library.SpellFilters.Active" count=monsterFilterCount}}</small>{{/if}}</summary>
      <div class="tovf-library-spell-filter-grid">
        <label><span>{{localize "TOVF.Library.MonsterFilters.Type"}}</span><select data-library-filter="monsterType"><option value="">{{localize "TOVF.Library.All"}}</option>{{selectOptions monsterTypes selected=selectedMonsterType valueAttr="value" labelAttr="label"}}</select></label>
        <label><span>{{localize "TOVF.Library.MonsterFilters.Size"}}</span><select data-library-filter="monsterSize"><option value="">{{localize "TOVF.Library.All"}}</option>{{selectOptions monsterSizes selected=selectedMonsterSize valueAttr="value" labelAttr="label"}}</select></label>
        <label><span>{{localize "TOVF.Library.MonsterFilters.Spellcaster"}}</span><select data-library-filter="monsterSpellcaster"><option value="">{{localize "TOVF.Library.All"}}</option><option value="yes" {{#if (eq selectedMonsterSpellcaster "yes")}}selected{{/if}}>{{localize "TOVF.Library.Yes"}}</option><option value="no" {{#if (eq selectedMonsterSpellcaster "no")}}selected{{/if}}>{{localize "TOVF.Library.No"}}</option></select></label>
        <label><span>{{localize "TOVF.Library.ChallengeRating"}}</span><span class="tovf-library-number-range"><input type="number" step="0.125" value="{{monsterCrMin}}" placeholder="Min" data-library-monster-number="CrMin"><input type="number" step="0.125" value="{{monsterCrMax}}" placeholder="Max" data-library-monster-number="CrMax"></span></label>
        <label><span>{{localize "TOVF.Library.MonsterFilters.AC"}}</span><span class="tovf-library-number-range"><input type="number" value="{{monsterAcMin}}" placeholder="Min" data-library-monster-number="AcMin"><input type="number" value="{{monsterAcMax}}" placeholder="Max" data-library-monster-number="AcMax"></span></label>
        <label><span>{{localize "TOVF.Library.MonsterFilters.HP"}}</span><span class="tovf-library-number-range"><input type="number" value="{{monsterHpMin}}" placeholder="Min" data-library-monster-number="HpMin"><input type="number" value="{{monsterHpMax}}" placeholder="Max" data-library-monster-number="HpMax"></span></label>
        <details class="tovf-library-spell-multi"><summary>{{localize "TOVF.Library.MonsterFilters.Movement"}}</summary><div>{{#each monsterMovements}}<label><input type="checkbox" value="{{value}}" data-library-monster-multi="movement" {{checked selected}}><span>{{label}}</span><small>{{count}}</small></label>{{/each}}</div></details>
        <details class="tovf-library-spell-multi"><summary>{{localize "TOVF.Library.MonsterFilters.Senses"}}</summary><div>{{#each monsterSenses}}<label><input type="checkbox" value="{{value}}" data-library-monster-multi="senses" {{checked selected}}><span>{{label}}</span><small>{{count}}</small></label>{{/each}}</div></details>
        <details class="tovf-library-spell-multi"><summary>{{localize "TOVF.Library.MonsterFilters.Resistances"}}</summary><div>{{#each monsterDamageResistances}}<label><input type="checkbox" value="{{value}}" data-library-monster-multi="resistances" {{checked selected}}><span>{{label}}</span><small>{{count}}</small></label>{{/each}}</div></details>
        <details class="tovf-library-spell-multi"><summary>{{localize "TOVF.Library.MonsterFilters.Immunities"}}</summary><div>{{#each monsterDamageImmunities}}<label><input type="checkbox" value="{{value}}" data-library-monster-multi="immunities" {{checked selected}}><span>{{label}}</span><small>{{count}}</small></label>{{/each}}</div></details>
        <details class="tovf-library-spell-multi"><summary>{{localize "TOVF.Library.MonsterFilters.Vulnerabilities"}}</summary><div>{{#each monsterDamageVulnerabilities}}<label><input type="checkbox" value="{{value}}" data-library-monster-multi="vulnerabilities" {{checked selected}}><span>{{label}}</span><small>{{count}}</small></label>{{/each}}</div></details>
        <details class="tovf-library-spell-multi"><summary>{{localize "TOVF.Library.MonsterFilters.ConditionImmunities"}}</summary><div>{{#each monsterConditionImmunities}}<label><input type="checkbox" value="{{value}}" data-library-monster-multi="conditionImmunities" {{checked selected}}><span>{{label}}</span><small>{{count}}</small></label>{{/each}}</div></details>
      </div>
      <div class="tovf-library-spell-toggles"><button type="button" class="{{#if monsterLegendary}}active{{/if}}" data-library-monster-legendary>{{localize "TOVF.Library.MonsterFilters.Legendary"}}</button><button type="button" class="reset" data-library-monster-reset {{#unless monsterFilterCount}}disabled{{/unless}}><i class="fa-solid fa-rotate-left" inert></i> {{localize "TOVF.Library.SpellFilters.Reset"}}</button></div>
    </details>
    {{/if}}
    {{#if showSpellFilters}}
    <details class="tovf-library-spell-filters" open>
      <summary>
        <span><i class="fa-solid fa-filter" inert></i> {{localize "TOVF.Library.SpellFilters.Title"}}</span>
        {{#if spellAdvancedFilterCount}}<small>{{localize "TOVF.Library.SpellFilters.Active" count=spellAdvancedFilterCount}}</small>{{/if}}
      </summary>
      <div class="tovf-library-spell-filter-grid">
        {{#*inline "spellFilter"}}
        <details class="tovf-library-spell-multi" data-library-spell-filter="{{key}}" {{#if counts.open}}open{{/if}}>
          <summary><span>{{label}}</span>{{#if counts.total}}<span class="tovf-library-filter-state">{{#if counts.include}}<small class="include">+{{counts.include}}</small>{{/if}}{{#if counts.exclude}}<small class="exclude">−{{counts.exclude}}</small>{{/if}}</span>{{/if}}</summary>
          <div>
            <div class="tovf-library-spell-multi-head" aria-hidden="true"><span></span><span>{{localize "TOVF.Library.SpellFilters.Include"}}</span><span>{{localize "TOVF.Library.SpellFilters.Exclude"}}</span><span></span></div>
            {{#each options}}<label><span>{{label}}</span><input type="checkbox" value="{{value}}" data-library-spell-multi="{{../key}}" data-library-spell-mode="include" aria-label="{{localize 'TOVF.Library.SpellFilters.Include'}}: {{label}}" {{checked included}}><input type="checkbox" value="{{value}}" data-library-spell-multi="{{../key}}" data-library-spell-mode="exclude" aria-label="{{localize 'TOVF.Library.SpellFilters.Exclude'}}: {{label}}" {{checked excluded}}><small>{{count}}</small></label>{{/each}}
          </div>
        </details>
        {{/inline}}
        {{> spellFilter label=(localize "TOVF.Library.SpellCastingTime.Label") key="castingTime" options=spellCastingTimes counts=spellFilterCounts.castingTime}}
        {{> spellFilter label=(localize "TOVF.Library.SpellDuration.Label") key="duration" options=spellDurations counts=spellFilterCounts.duration}}
        {{> spellFilter label=(localize "TOVF.Library.SpellResolution.Label") key="resolution" options=spellResolutionOptions counts=spellFilterCounts.resolution}}
        {{> spellFilter label=(localize "TOVF.Library.DamageTypes") key="damage" options=spellDamageTypes counts=spellFilterCounts.damage}}
        {{> spellFilter label=(localize "TOVF.Library.Conditions") key="condition" options=spellConditions counts=spellFilterCounts.condition}}
        {{> spellFilter label=(localize "TOVF.Library.Components") key="component" options=spellComponents counts=spellFilterCounts.component}}
        {{> spellFilter label=(localize "TOVF.Library.SpellProperties") key="property" options=spellPropertyOptions counts=spellFilterCounts.property}}
        {{> spellFilter label=(localize "TOVF.Library.SpellRange.Label") key="range" options=spellRanges counts=spellFilterCounts.range}}
        <div class="tovf-library-spell-reset-slot">
          <label><span>{{localize "TOVF.Library.Sort.Label"}}</span><select data-library-filter="spellSort"><option value="name" {{#if (eq selectedSpellSort "name")}}selected{{/if}}>{{localize "TOVF.Library.Sort.Name"}}</option><option value="circle" {{#if (eq selectedSpellSort "circle")}}selected{{/if}}>{{localize "TOVF.Library.Sort.Circle"}}</option></select></label>
          <button type="button" class="reset" data-library-spell-reset {{#unless spellAdvancedFilterCount}}disabled{{/unless}}><i class="fa-solid fa-rotate-left" inert></i> {{localize "TOVF.Library.SpellFilters.Reset"}}</button>
        </div>
      </div>
    </details>
    {{/if}}
    </div>
    <p class="hint" data-library-count>{{localize "TOVF.Library.Results" count=resultCount}}</p>

    <ol class="tovf-library-results {{#if gridLayout}}grid{{/if}}">
      {{#each entries}}
      <li class="{{#if @root.tableBuilder}}table-builder{{/if}} {{#if showPrice}}has-price{{/if}}{{#if (eq category 'spells')}}has-price{{/if}}" draggable="true" data-library-entry data-uuid="{{uuid}}" data-document-type="{{documentType}}"
          data-name="{{lowerName}}">
        {{#if @root.tableBuilder}}<span class="tovf-library-table-select-slot"><input class="tovf-library-table-select" type="checkbox"
          data-table-entry-select aria-label="{{name}} für Rolltable auswählen" {{checked tableSelected}}></span>{{/if}}
        <img src="{{img}}" alt="">
        <button type="button" data-action="openDocument">
          <strong>{{name}}{{#if spellConcentration}} <abbr class="tovf-spell-marker concentration" title="Concentration">C</abbr>{{/if}}{{#if spellRitual}} <abbr class="tovf-spell-marker ritual" title="Ritual">R</abbr>{{/if}}</strong>
          <span title="{{packLabel}}">{{packLabel}}</span>
        </button>
        {{#if showPrice}}<span class="tovf-library-price"><i class="fa-solid fa-coins"></i> {{priceValue}} {{priceDenomination}}</span>{{/if}}
        {{#if (eq category "spells")}}<span class="tovf-library-price tovf-library-circle"><i class="fa-solid fa-circle"></i> {{#if spellCircle}}{{localize "TOVF.Library.SpellCircle.Circle" circle=spellCircle}}{{else}}{{localize "TOVF.Library.SpellCircle.Cantrip"}}{{/if}}</span>{{/if}}
        <button type="button" class="source" data-action="openPack" data-pack="{{pack}}"
                title="{{sourceSummary}} · {{packLabel}}">
          {{shortSourceLabel}}{{#if hasDuplicates}} · {{duplicateCount}}{{/if}}
        </button>
      </li>
      {{else}}
      <li class="empty">{{localize "TOVF.Library.Empty"}}</li>
      {{/each}}
    </ol>
  </section>
</div>
