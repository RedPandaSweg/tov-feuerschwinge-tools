<section class="tovf-token-preset-body">
  <aside class="tovf-token-preset-help">
    <div class="tovf-token-preset-explanation">
      <i class="fa-solid fa-circle-info" inert></i>
      <span><strong>Scale</strong> bestimmt die Bildgröße (maximal 3). <strong>Breite</strong> und <strong>Höhe</strong> bestimmen die belegten Rasterfelder.</span>
    </div>
    <div class="tovf-token-size-recommendations" aria-label="Empfohlene Tokengrößen">
      <span><em>Tiny</em><b>Scale 0,5 · 1×1</b></span>
      <span><em>Small</em><b>Scale 0,8 · 1×1</b></span>
      <span><em>Medium</em><b>Scale 1 · 1×1</b></span>
      <span><em>Large</em><b>Scale 1 · 2×2</b></span>
      <span><em>Huge</em><b>Scale 1 · 3×3</b></span>
      <span><em>Gargantuan</em><b>Scale 1 · 4×4</b></span>
    </div>
  </aside>
  <div class="tovf-token-preset-list">
    {{#each presets}}
    <div class="tovf-token-preset" data-preset="{{id}}">
      <button type="button" class="tovf-token-preset-drag" title="Preset verschieben" aria-label="Preset verschieben">
        <i class="fa-solid fa-grip-vertical" inert></i>
      </button>
      <button type="button" class="tovf-token-preset-image" data-action="chooseImage" title="Tokenbild auswählen" aria-label="Tokenbild auswählen">
        <span class="tovf-token-space"><img src="{{image}}" alt="Tokenbild für {{name}}"></span>
      </button>
      <label class="tovf-token-preset-name">Presetname <input type="text" name="name" value="{{name}}" placeholder="Name"></label>
      <label class="tovf-token-name">Tokenname <input type="text" name="tokenName" value="{{tokenName}}" placeholder="Unverändert"></label>
      <input type="hidden" name="image" value="{{image}}">
      <label>Scale <input type="number" name="scale" value="{{scale}}" min="0.1" max="3" step="0.05"></label>
      <label>Breite <input type="number" name="width" value="{{width}}" min="0.5" max="20" step="0.5"></label>
      <label>Höhe <input type="number" name="height" value="{{height}}" min="0.5" max="20" step="0.5"></label>
      <button type="button" data-action="apply"><i class="fa-solid fa-check"></i> Aktivieren</button>
      <button type="button" data-action="remove" class="icon"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{else}}<p>Noch keine Presets vorhanden.</p>{{/each}}
  </div>
  <footer><button type="button" data-action="add"><i class="fa-solid fa-plus"></i> Neues Preset</button><button type="button" data-action="save"><i class="fa-solid fa-floppy-disk"></i> Speichern</button></footer>
</section>
