<section class="standard-form">
  <p class="hint">{{localize "TOVF.LinkTools.Description"}}</p>
  <fieldset>
    <legend>{{localize "TOVF.LinkTools.AuditTitle"}}</legend>
    <p class="hint">{{localize "TOVF.LinkTools.AuditHint"}}</p>
    <button type="button" data-action="audit">
      <i class="fa-solid fa-magnifying-glass" inert></i>
      {{localize "TOVF.LinkTools.Audit"}}
    </button>
  </fieldset>
  <fieldset>
    <legend>{{localize "TOVF.LinkTools.ImagesTitle"}}</legend>
    <p class="hint">{{localize "TOVF.LinkTools.ImagesHint"}}</p>
    <button type="button" data-action="repairMissingImages">
      <i class="fa-solid fa-image" inert></i>
      {{localize "TOVF.LinkTools.ImagesRepair"}}
    </button>
  </fieldset>
  <fieldset>
    <legend>{{localize "TOVF.LinkTools.CompendiumAuditTitle"}}</legend>
    <p class="hint">{{localize "TOVF.LinkTools.CompendiumAuditHint"}}</p>
    <button type="button" data-action="auditCompendiums">
      <i class="fa-solid fa-books" inert></i>
      {{localize "TOVF.LinkTools.CompendiumAudit"}}
    </button>
  </fieldset>
  <fieldset>
    <legend>{{localize "TOVF.LinkTools.RepairTitle"}}</legend>
    <p class="hint">{{localize "TOVF.LinkTools.RepairHint"}}</p>
    <button type="button" data-action="repair">
      <i class="fa-solid fa-screwdriver-wrench" inert></i>
      {{localize "TOVF.LinkTools.Repair"}}
    </button>
  </fieldset>
  <fieldset>
    <legend>{{localize "TOVF.LinkTools.WeaponActivitiesTitle"}}</legend>
    <p class="hint">{{localize "TOVF.LinkTools.WeaponActivitiesHint"}}</p>
    <button type="button" data-action="synchronizeWeaponActivities">
      <i class="fa-solid fa-swords" inert></i>
      {{localize "TOVF.LinkTools.WeaponActivities"}}
    </button>
  </fieldset>
</section>
