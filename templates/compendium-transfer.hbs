<div class="tovf-session-transfer-root">
  <p class="hint">{{localize "TOVF.Transfer.Settings.Hint"}}</p>

  <fieldset class="tovf-transfer-specialist">
    <legend>{{localize "TOVF.Transfer.Export.Title"}}</legend>
    <p class="hint">{{localize "TOVF.Transfer.Export.Hint"}}</p>
    <div class="form-group">
      <label>{{localize "TOVF.Transfer.Folder"}}</label>
      <div class="form-fields">
        <select name="standaloneCompendiumFolder">
          {{selectOptions compendiumFolders valueAttr="id" labelAttr="name"}}
        </select>
      </div>
    </div>
    <button type="button" data-action="exportCompendiums">
      <i class="fa-solid fa-download" inert></i> {{localize "TOVF.Transfer.Export.Action"}}
    </button>
  </fieldset>

  <fieldset class="tovf-transfer-specialist">
    <legend>{{localize "TOVF.Transfer.Import.Title"}}</legend>
    <p class="hint">{{localize "TOVF.Transfer.Import.Hint"}}</p>
    <div class="form-group">
      <label>{{localize "TOVF.Transfer.File"}}</label>
      <div class="form-fields">
        <input type="file" name="compendiumFile" accept=".json,application/json">
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "TOVF.Transfer.Destination"}}</label>
      <div class="form-fields">
        <select name="compendiumDestination">
          {{selectOptions compendiumDestinations valueAttr="id" labelAttr="name"}}
        </select>
      </div>
    </div>
    <button type="button" data-action="importCompendiums">
      <i class="fa-solid fa-upload" inert></i> {{localize "TOVF.Transfer.Import.Action"}}
    </button>
  </fieldset>
</div>
